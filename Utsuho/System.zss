[Function ActionStart(ActionLock)]
map(ActionLock) := $ActionLock;
map(CanActionCancel) := 0;
map(CanMotionCancel) := 0;
map(CanGuard) := 0;

[Function BorderBreak()]
let SokuBorderBreaks = floor(map(SokuBorderBreaks));
map(SokuBorderBreaks) := min($SokuBorderBreaks+1,5);
guardPointsSet{value: 1000-(200*map(SokuBorderBreaks));}
if $SokuBorderBreaks < 5 {
	explod{id: 200010; anim: 200001; postype: left; pos: cond(teamSide = 2,screenWidth-64-(13.5*(5-$SokuBorderBreaks)),64+(13.5*(5-$SokuBorderBreaks))),screenHeight-cond((5-$SokuBorderBreaks)%2,20.5,17); layerno: 1; sprpriority: 10; bindtime: -1; facing: cond(teamSide = 2,-1,1); removetime: -2; scale: 0.5,0.5; supermovetime: -1; pausemovetime: -1; ownpal: 1;}
}

[Function HitEffect(Effect, charID, targetID)]
if !playerId($charID),pauseTime {
	let sparkx = playerId($charID),pos X+(playerId($charID),hitDefVar(sparkx)*playerId($charID),facing);
	let sparky = playerId($charID),pos Y+playerId($charID),groundLevel+playerId($charID),hitDefVar(sparky);
	let enleft = min(playerId($targetID),clsnVar(size, 0, front)*playerId($targetID),facing, playerId($targetID),clsnVar(size, 0, back)*playerId($targetID),facing)+playerId($targetID),pos X;
	let enright = max(playerId($targetID),clsnVar(size, 0, front)*playerId($targetID),facing, playerId($targetID),clsnVar(size, 0, back)*playerId($targetID),facing)+playerId($targetID),pos X;
	let entop = playerId($targetID),pos Y+playerId($targetID),groundLevel;
	let enbot = playerId($targetID),clsnVar(size, 0, bottom)+$entop;
	let entop = playerId($targetID),clsnVar(size, 0, top)+$entop;
	let sparkx = cond($sparkx < $enleft,$enleft,cond($sparkx > $enright,$enright,$sparkx))+cameraPos X;
	let sparky = cond($sparky < $entop,$entop,cond($sparky > $enbot,$enbot,$sparky));
	let numbluebeams = 0;
	let numredbeams = 0;
	let numparticles = 0;

	if selfAnimExist(99999+floor($Effect)) {
		explod{id: 99999+floor($Effect); anim: 99999+floor($Effect); pos: $sparkx,$sparky; postype: none; angle: randomRange(-18000,18000)/100.0; ontop: 1; bindtime: 0; removetime: -2; supermovetime: -1; pausemovetime: -1; shader: "trans_rights"; shadertime: -1; ownpal: 1; ignorehitpause: 1; redirectid: $charID;}
	}

	switch $Effect {
		case 1:
			let numparticles = 3;
		case 2:
			let numparticles = 6;
			let numbluebeams = 3;
			let numredbeams = 3;
		case 3:
			explod{id: 100053; anim: 100053; pos: $sparkx,$sparky; postype: none; ontop: 1; bindtime: 0; removetime: -2; supermovetime: -1; pausemovetime: -1; shader: "trans_rights"; shadertime: -1; ownpal: 1; ignorehitpause: 1; palfx.time: -1; palfx.mul: 256,256,256; interpolation.time: 12; interpolation.palfx.mul: 0,0,256; redirectid: $charID;}
			let numparticles = 6;
			let numbluebeams = 6;
			let numredbeams = 6;
		case 4:
			explod{id: 100054; anim: 100054; pos: $sparkx,$sparky; postype: none; ontop: 1; bindtime: 0; removetime: -2; supermovetime: -1; pausemovetime: -1; shader: "trans_rights"; shadertime: -1; ownpal: 1; ignorehitpause: 1; palfx.time: -1; palfx.mul: 256,256,256; interpolation.time: 12; interpolation.palfx.mul: 0,0,256; redirectid: $charID;}
			let numparticles = 6;
			let numbluebeams = 6;
			let numredbeams = 6;
	#	case 5:
	#	case 6:
	#	case 7:
	#	case 8:
	#	case 9:
	#	case 10:
	#	case 11:
	#	case 12:
		case 13:
			explod{id: 100062; anim: 100062; pos: $sparkx,$sparky; postype: none; ontop: 1; bindtime: 0; removetime: -2; supermovetime: -1; pausemovetime: -1; shader: "trans_rights"; shadertime: -1; ownpal: 1; ignorehitpause: 1; palfx.time: -1; palfx.mul: 256,256,256; interpolation.time: 16; interpolation.palfx.mul: 0,0,256; redirectid: $charID;}
			let numbluebeams = 4;
	#	case 14:
	#	case 15:
	#	case 16:
	}

	for i = 1; $numparticles; 1 {
		let escale = randomRange(0,100)/100.0;
		let eangle = randomRange(-18000,18000)*pi/18000.0;
		let espeed = randomRange(400,1000)/100.0;
		explod{anim: 100050; ID: 100050; pos: $sparkx,$sparky; postype: none; bindtime: 0; vel: $espeed*sin($eangle),$espeed*cos($eangle); removetime: -2; pausemovetime: -1; supermovetime: -1; scale: $escale,$escale; ontop: 1; shader: "trans_rights"; shadertime: -1; ownpal: 1; ignorehitpause: 1; redirectid: $charID;}
	}

	for i = 1; $numbluebeams; 1 {
		let eangle = randomRange(-18000,18000)/100.0;
		let edir = rad($eangle);
		let espeed = randomRange(0,1000)/100.0;
		explod{anim: 100051; ID: 100051; pos: $sparkx,$sparky; postype: none; bindtime: 0; vel: $espeed*sin($edir),$espeed*cos($edir); removetime: -2; pausemovetime: -1; supermovetime: -1; scale: randomRange(100,3000)/100.0,randomRange(100,400)/100.0; angle: $eangle-90; ontop: 1; shader: "trans_rights"; shadertime: -1; ownpal: 1; ignorehitpause: 1; redirectid: $charID;}
	}

	for i = 1; $numredbeams; 1 {
		let eangle = randomRange(-18000,18000)/100.0;
		let edir = rad($eangle);
		let espeed = randomRange(0,1000)/100.0;
		explod{anim: 100052; ID: 100052; pos: $sparkx,$sparky; postype: none; bindtime: 0; vel: $espeed*sin($edir),$espeed*cos($edir); removetime: -2; pausemovetime: -1; supermovetime: -1; scale: randomRange(100,3000)/100.0,randomRange(100,400)/100.0; angle: $eangle-90; ontop: 1;shader: "trans_rights"; shadertime: -1; ownpal: 1; ignorehitpause: 1; redirectid: $charID;}
	}
}

#===============================================================================
# PreUpdate
#===============================================================================
[StateDef 1618521;
type: S; movetype: I; physics: N;
anim: 9999; ctrl: 0; velset: 0, 0;]
ignoreHitPause {
let rootID = root,ID;

for i = root,numProjID(1304)-1; 0; -1 {
	if root,projVar(1304, $i, projremovetime) = 12 {
		modifyProjectile{id: 1304; index: $i; projanim: 1306; velocity: 0,0; accel: 0,0; redirectid: $rootID;}
	}
}

assertSpecial{flag: RunFirst;}
notHitBy{attr: SCA,AA,AP,AT; time: 1; slot: 0;}
overrideClsn{group: size; index: 0; rect: 0, 0, 0, 0;}

for i = cond(teamSide%2,2,1); (enemy,numPartner+1)*2 - (1-(teamSide%2)); 2 {
	let charID = player($i),ID;
	if player($i),moveType = H && player($i),stateNo != 5150 {
		if player($i),getHitVar(frame) {
			let behind = sign(round(player($i),pos X-root,pos X, 0));
			if !$behind {
				let behind = root,facing;
			}
			if !player($i),getHitVar(guarded) {
				let prevrate = 1.0;
				let origdamagecalc = 0;
				let finaldamagecalc = 0;
				let hashit = 0;
				for h = root,numHelper; 0; -1 {
					if root,helperIndex($h),moveHitVar(frame) && root,helperIndex($h),moveHitVar(playerid) = $charID {
						let origdamage = round(root,helperIndex($h),hitDefVar(hitdamage)*root,helperIndex($h),attack/player($i),defence, 0);
						let origdamagecalc = $origdamagecalc+$origdamage;
						if player($i),map(SokuComboLimit) < 100 {
							let modifiers = player($i),map(SokuModifierHits);
							let finaldamagecalc = $finaldamagecalc+round($origdamage*player($i),map(SokuComboRate)*cond($modifiers, cond($modifiers = 3, 0.64, 0.8),1)*lerp(0.7, 1, float(player($i),life-$finaldamagecalc)/player($i),lifeMax), 0);
							let prevrate = player($i),map(SokuComboRate);
							mapSet{map: "SokuComboLimit"; value: player($i),map(SokuComboLimit)+root,helperIndex($h),map(LimitGain); redirectid: $charID;}
							if player($i),map(SokuComboLimit) >= 100 {
								explod{id: 105400; anim: 105400; facing: player($i),facing*facing; pos: 0,-50; postype: P1; sprpriority: 0; bindtime: -1; bindid: $charID; removetime: -1; scale: 2.45,2.45; interpolation.time: 7; interpolation.scale: 1,1; supermovetime: -1; pausemovetime: -1; shader: "trans_rights"; shadertime: -1; ownpal: 1; ignorehitpause: 1;}
								modifyExplod{id: 105400; index: numExplod(105400)-1; bindid: $charID;}
								explod{id: 105400; anim: 105401; facing: player($i),facing*facing; pos: 0,-50; postype: P1; sprpriority: 0; bindtime: -1; bindid: $charID; removetime: -1; supermovetime: -1; pausemovetime: -1; shader: "trans_rights"; shadertime: -1; ownpal: 1; ignorehitpause: 1;}
								modifyExplod{id: 105400; index: numExplod(105400)-1; bindid: $charID;}
								getHitVarSet{xvel: player($i),getHitVar(air.velocity.x); yvel: player($i),getHitVar(air.velocity.y); fall: 1; fall.recover: 0; redirectid: $charID;}
							}
							mapSet{map: "SokuComboRate"; value: player($i),map(SokuComboRate)*root,helperIndex($h),map(Proration); redirectid: $charID;}
							mapSet{map: "SokuModifierHits"; value: floor(player($i),map(SokuModifierHits))|floor(root,helperIndex($h),map(SokuComboModifiers)); redirectid: $charID;}
						} else {
							modifyPlayer{movehit: 0; hitpausetime: 0; redirectid: root,helperIndex($h),ID;}
							hitAdd{value: -1; redirectid: root,helperIndex($h),ID;}
						}
					}
				}
				if player($i),getHitVar(playerno) = playerNo {
					mapSet{map: "SokuGetHitType"; value: playerId(player($i),getHitVar(playerid)),map(SokuHitType); redirectid: $charID;}
					mapSet{map: "SokuFriction"; value: playerId(player($i),getHitVar(playerid)),map(SokuHitFriction); redirectid: $charID;}
				}
				powerAdd{value: floor($finaldamagecalc*0.5*(1000.0/player($i),lifeMax)); redirectid: $charID;}
				getHitVarSet{damage: player($i),getHitVar(hitdamage)-$origdamagecalc+$finaldamagecalc; redirectid: $charID;}
				if player($i),hitFall {
					getHitVarSet{fall.recovertime: (player($i),getHitVar(fall.recovertime)-player($i),getHitVar(HitShakeTime))*$prevrate + player($i),getHitVar(HitShakeTime); redirectid: $charID;}
				}
				if $behind = player($i),facing {
					turn{redirectid: $charID;}
				}
			} else {
				if player($i),stateType = A && player($i),getHitVar(animtype) > 1 {
					if root,moveHitVar(frame) && root,moveGuarded && root,hasHit($charID) {
						getHitVarSet{guardpoints: player($i),getHitVar(guardpoints)+100; redirectid: $charID;}
						mapSet{map: "SokuBorderCooldown"; value: 90-player($i),hitShakeOver; redirectid: $charID;}
					} else {
						mapSet{map: "SokuBorderCooldown"; value: 75-player($i),hitShakeOver; redirectid: $charID;}
					}
				} else if player($i),getHitVar(guardpoints) > 0 {
					mapSet{map: "SokuBorderCooldown"; value: 60-player($i),hitShakeOver; redirectid: $charID;}
				}
				if player($i),getHitVar(guardpoints) > 0 {
					mapSet{map: "_iksys_guardPointsTimer"; value: player($i),map(SokuBorderCooldown); redirectid: $charID;}
				}
			}
			if player($i),getHitVar(playerno) = playerNo && playerId(player($i),getHitVar(playerid)),facing != $behind {
				getHitVarSet{xvel: -player($i),getHitVar(xvel); redirectid: $charID;}
			}
		}
		if player($i),getHitVar(playerno) = playerNo && !player($i),pauseTime && !player($i),inCustomState {
			let SokuGetHitType = player($i),map(SokuGetHitType);
			if player($i),hitShakeOver {
				if player($i),stateType = S || player($i),stateType = C {
					let xvel = player($i),vel X;
					let dir = sign($xvel);
					if player($i),getHitVar(guarded) {
						velSet{x: max(0,abs($xvel)-0.3)*$dir; redirectid: $charID;}
					} else {
						velSet{x: max(0,abs($xvel)-player($i),map(SokuFriction))*$dir; redirectid: $charID;}
					}
				} else if !player($i),getHitVar(guarded) && player($i),stateType != L {
					if player($i),vel Y {
						if $SokuGetHitType != 3 {
							getHitVarSet{fall.yvel: player($i),vel Y/-2; redirectid: $charID;}
						}
					}
					if !$SokuGetHitType && !player($i),getHitVar(frame) && player($i),getHitVar(yaccel) = 0.25 && player($i),hitFall && player($i),vel Y <= 0 {
						velAdd{y: 0.25; redirectid: $charID;}
					} else if $SokuGetHitType = 2 && player($i),backEdgeBodyDist <= 0 {
						selfState{value: 5600; ctrl: 0; continue: 1; readplayerid: $rootID; redirectid: $charID;}
						playSnd{value: S52,1; volumescale: 200; abspan: player($i),pos X;}
						explod{id: 105100; anim: 105100; pos: gameWidth/2.0*sign(player($i),pos X)+camerapos X,player($i),pos Y+player($i),groundLevel-50; postype: none; sprpriority: 0; bindtime: 0; facing: 1; removetime: -2; supermovetime: -1; pausemovetime: -1; ownpal: 1; yangle: -80; shader: "trans_rights"; shadertime: -1;}
						explod{id: 100003; anim: 100003; pos: gameWidth/2.0*sign(player($i),pos X)+camerapos X,player($i),pos Y+player($i),groundLevel-50; postype: none; ontop: 1; bindtime: 0; facing: 1; removetime: -2; supermovetime: -1; pausemovetime: -1; ownpal: 1; angle: randomRange(-18000,18000)/100.0; shader: "trans_rights"; shadertime: -1;}
						mapSet{map: "SokuGetHitType"; value: -1; redirectid: $charID;}
					}
				}
			} else if !player($i),getHitVar(guarded) && player($i),getHitVar(yvel) > 0 {
				if $SokuGetHitType != 3 {
					getHitVarSet{fall.yvel: player($i),getHitVar(yvel)/-2; redirectid: $charID;}
				}
			}
		}
		if player($i),getHitVar(playerid) = $rootID && ((!player($i),map(SokuGetHitType) && player($i),getHitVar(yaccel) = 0.25) || player($i),getHitVar(guarded) || player($i),stateType != A) && player($i),backEdgeBodyDist+player($i),vel X <= 0 {
			mapSet{map: "DoSokuCornerPush"; value: cond(player($i),stateType = A,3,1+player($i),getHitVar(guarded)); redirectid: $rootID;}
		}
	}
}

for i = 0; root,numHelper; 1 {
	
	if root,helperIndex($i),map(SokuHitEffect) > 0 && root,helperIndex($i),moveHitVar(frame) && root,helperIndex($i),moveHit {
		let charID = root,helperIndex($i),ID;
		let targetID = root,helperIndex($i),moveHitVar(playerid);
		if root,helperIndex($i),map(ZenithClashNonCompat) {
			for en = cond(teamSide%2,2,1); (enemy,numPartner+1)*2 - (1-(teamSide%2)); 2 {
				if player($en),getHitVar(frame) && !player($en),getHitVar(guarded) && $targetID = player($en),ID {
					call HitEffect(root,helperIndex($i),map(SokuHitEffect), $charID, $targetID);
				}
			}
		} else {
			call HitEffect(root,helperIndex($i),map(SokuHitEffect), $charID, $targetID);
		}
	}
}

for i = numExplod(105400)-1; 0; -1 {
	let charID = explodVar(105400, $i, bindid);
	if playerId($charID),map(SokuComboLimit) < 100 {
		explod{id: 105401; anim: explodVar(105400, $i, anim); animelem: explodVar(105400, $i, animelem); animelemtime: explodVar(105400, $i, animelemtime); facing: explodVar(105400, $i, facing)*facing; pos: 0,-50; postype: P1; sprpriority: 0; bindtime: -1; removetime: 13; trans: add; alpha: 256,256; palfx.time: -1; palfx.mul: 256,256,256; interpolation.time: 13; interpolation.alpha: 0,256; interpolation.palfx.mul: 0,0,256; supermovetime: -1; pausemovetime: -1; shader: "trans_rights"; shadertime: -1; ownpal: 1; ignorehitpause: 1;}
		modifyExplod{id: 105401; index: numExplod(105401)-1; bindid: $charID;}
		removeExplod{id: 105400; index: $i;}
	} else {
		let expscl = 1.1+(sin((360+explodVar(105400, $i, animtime))*pi/60)*0.1);
		if explodVar(105400, $i, anim) = 105400 {
			let expscl = $expscl*0.9;
		}
		modifyExplod{id: 105400; index: $i; scale: $expscl,$expscl;}
	}
}

for i = 0; numExplod(105401)-1; 1 {
	let expscl = 1.1+(sin((360+explodVar(105401, $i, animtime))*pi/60)*0.1);
	if explodVar(105401, $i, anim) = 105400 {
		let expscl = $expscl*0.9;
	}
	modifyExplod{id: 105401; index: $i; scale: $expscl,$expscl;}
}

}

[StateDef -4]
ignoreHitPause {

if !roundState {
	map(SokuBorderBreaks) := 0;
	map(SokuBorderBreakRecovery) := 0;
	map(_iksys_guardPointsTimer) := 0;
	guardPointsSet{value: 1000;}
}

if enemyNear,name = "Flandre_Scarlet" {
	map(BasePriority) := 5;
} else {map(BasePriority) := 4;}

if isHelper(1211920) {
	if root,numHelper(1211920) > 1 { # This shouldn't be possible, what the fuck
		destroySelf{}
	}
	for i = numPlayer-1; 0; -1 {
		if playerIndex($i),ID = ID {break;}
		if playerIndex($i),runOrder > runOrder && !playerIndex($i),isHelper(1211920) {
			helper{name: "PostUpdate"; id: 1211920; stateno: 1211920; supermovetime: -1; pausemovetime: -1; redirectid: root,ID;}
			destroySelf{removeexplods: 1;}
		}
	}
}

assertSpecial{flag: NoJump; flag2: NoStandGuard; flag3: NoCrouchGuard; flag4: NoAirGuard; flag5: NoIntroReset; flag6: NoMakeDust; flag7: NoAutoTurn}

if inputtime(a) > 0 {
	if command = "8a" {assertCommand{name: "8a"; buffer.time: max(8-inputtime(a), 2);}}
	if command = "6a" {assertCommand{name: "6a"; buffer.time: max(8-inputtime(a), 2);}}
	if command = "4a" {assertCommand{name: "4a"; buffer.time: max(8-inputtime(a), 2);}}
	if command = "1a" {assertCommand{name: "1a"; buffer.time: max(8-inputtime(a), 2);}}
	if command = "3a" {assertCommand{name: "3a"; buffer.time: max(8-inputtime(a), 2);}}
	if command = "2a" {assertCommand{name: "2a"; buffer.time: max(8-inputtime(a), 2);}}
	if command = "a" {assertCommand{name: "a"; buffer.time: max(8-inputtime(a), 2);}}
}

if inputtime(b) > 0 {
	if command = "2b" {assertCommand{name: "2b"; buffer.time: max(8-inputtime(b), 2);}}
	if command = "b" {assertCommand{name: "b"; buffer.time: max(8-inputtime(b), 2);}}
}

if inputtime(c) > 0 {
	if command = "c" {assertCommand{name: "c"; buffer.time: max(8-inputtime(c), 2);}}
	if command = "6c" {assertCommand{name: "6c"; buffer.time: max(8-inputtime(c), 2);}}
	if command = "4c" {assertCommand{name: "4c"; buffer.time: max(8-inputtime(c), 2);}}
	if command = "2c" {assertCommand{name: "2c"; buffer.time: max(8-inputtime(c), 2);}}
}

if !isHelper {

if numProj && moveType = H && !getHitVar(guarded) {
	modifyProjectile{projid: -1;}
}

if getHitVar(guardpoints) > 0 {
	if stateType = A && getHitVar(animtype) > 1 {
		if getHitVar(attr) = SCA,AA {
			mapSet{map: "_iksys_guardPointsTimer"; value: 90-hitShakeOver;}
		} else {
			mapSet{map: "_iksys_guardPointsTimer"; value: 75-hitShakeOver;}
		}
	} else {
		mapSet{map: "_iksys_guardPointsTimer"; value: 60-hitShakeOver;}
	}
}

if introState || win {
	notHitBy{attr: SCA,AA,AP,AT; time: 1; slot: 5;}
}

map(NoElectron) := 0;

if !numHelper(100990) {
	helper{name: "ElectronPos"; id: 100990; stateno: 100990; supermovetime: 0; pausemovetime: 0;}
}

if !numHelper(1211920) {
	helper{name: "PostUpdate"; id: 1211920; stateno: 1211920; supermovetime: -1; pausemovetime: -1;}
	assertSpecial{flag: RunLast; redirectid: lastPlayerID;}
}

if !numHelper(1618521) {
	helper{name: "PreUpdate"; id: 1618521; stateno: 1618521; supermovetime: -1; pausemovetime: -1;}
}

}

}

[StateDef -2]

map(IsSokuGrazing) := 0;
map(SokuBorderBreaks) := max(0,min(map(SokuBorderBreaks),5));

if stateNo != const(StateGuardBreakHit) {
	guardBreakSet{value: 0;}
}

if hitShakeOver {
	if map(_iksys_guardPointsTimer) > 0 {
		map(_iksys_guardPointsTimer) := map(_iksys_guardPointsTimer)-1;
	} else {
		guardPointsAdd{value: 6;}
	}
}

if guardPoints > 1000-(200*floor(map(SokuBorderBreaks))) {
	guardPointsSet{value: 1000-(200*floor(map(SokuBorderBreaks)));}
}

if hitShakeOver {
	let SokuBorderBreakRecovery = map(SokuBorderBreakRecovery);
	let SokuBorderBreaks = map(SokuBorderBreaks);
	switch $SokuBorderBreaks {
		case 1:
			map(SokuBorderBreakRecovery) := $SokuBorderBreakRecovery+5;
		case 2:
			map(SokuBorderBreakRecovery) := $SokuBorderBreakRecovery+7;
		case 3:
			map(SokuBorderBreakRecovery) := $SokuBorderBreakRecovery+10;
		case 4:
			map(SokuBorderBreakRecovery) := $SokuBorderBreakRecovery+18;
		case 5:
			map(SokuBorderBreakRecovery) := $SokuBorderBreakRecovery+28;
	}
	if map(SokuBorderBreakRecovery) >= 4800 {
		playSnd{value: S3,4;}
		explod{id: 200011; anim: 200002; postype: left; pos: cond(teamSide = 2,screenWidth-64-(13.5*(6-$SokuBorderBreaks)),64+(13.5*(6-$SokuBorderBreaks))),screenHeight-cond((6-$SokuBorderBreaks)%2,20.5,17); layerno: 1; sprpriority: 10; bindtime: -1; facing: cond(teamSide = 2,-1,1); removetime: -2; scale: 0.5,0.5; supermovetime: -1; pausemovetime: -1; ownpal: 1;}
		map(SokuBorderBreaks) := $SokuBorderBreaks-1;
		map(SokuBorderBreakRecovery) := 0;
	}
}

if map(DoSokuCornerPush) = 1 {
	posAdd{x: map(SokuCornerPush)*facing;}
} else if map(DoSokuCornerPush) = 2 {
	posAdd{x: map(SokuGuardCornerPush)*facing;}
} else if map(DoSokuCornerPush) = 3 {
	posAdd{x: map(SokuAirCornerPush)*facing;}
}

map(SokuCornerPush) := max(0, abs(map(SokuCornerPush))-map(SokuCornerPushDecel))*sign(map(SokuCornerPush));
map(SokuGuardCornerPush) := max(0, abs(map(SokuGuardCornerPush))-map(SokuGuardCornerPushDecel))*sign(map(SokuGuardCornerPush));
map(SokuAirCornerPush) := max(0, abs(map(SokuAirCornerPush))-1)*sign(map(SokuAirCornerPush));

if !map(SokuCornerPush) && !map(SokuGuardCornerPush) && !map(SokuAirCornerPush) {
	map(DoSokuCornerPush) := 0;
}

[StateDef -3]

if getHitVar(guarded) && getHitVar(guardpoints) > 0 && getHitVar(guardpoints) >= guardPoints {
	changeState{value: const(StateGuardBreakHit); ctrl: 0;}
}

[StateDef const(StateGuardBreakHit); type: U; movetype: H; physics: N; velset: 0, 0; anim: 5300; ctrl: 0;]

if !time {
	if stateType = C {
		stateTypeSet{statetype: S;}
	}
	guardBreakSet{value: 1}
	if p2Dist X < 0 {turn{}}
	getHitVarSet{guardpoints: 0;}
	playSnd{value: S3,1;}
	call BorderBreak();
	explod{id: 100054; anim: 100054; facing: 1; pos: 0,-50; postype: P1; ontop: 1; bindtime: 0; removetime: -2; supermovetime: -1; pausemovetime: -1; shader: "trans_rights"; shadertime: -1; ownpal: 1; ignorehitpause: 1; palfx.time: -1; palfx.mul: 256,256,256; interpolation.time: 12; interpolation.palfx.mul: 0,0,256;}
	let eangle = randomRange(-18000,18000)/100.0;
	explod{id: 105300; anim: 105300; facing: 1; angle: $eangle; pos: 0,-50; postype: P1; ontop: 1; bindtime: 0; removetime: -2; supermovetime: -1; pausemovetime: -1; shader: "trans_rights"; shadertime: -1; ownpal: 1; ignorehitpause: 1; palfx.time: -1; palfx.mul: 256,256,256; interpolation.time: 26; interpolation.palfx.mul: 0,0,256;}
	for i = 1; 9; 1 {
		let escale = randomRange(0,100)/100.0;
		let eangle = randomRange(-18000,18000)*pi/18000.0;
		let espeed = randomRange(400,1000)/100.0;
		explod{anim: 100050; ID: 100050; pos: 0,-50; postype: p1; facing: 1; bindtime: 0; vel: $espeed*sin($eangle),$espeed*cos($eangle); removetime: -2; pausemovetime: -1; supermovetime: -1; scale: $escale,$escale; ontop: 1; shader: "trans_rights"; shadertime: -1; ownpal: 1; ignorehitpause: 1;}
	}
	for i = 1; 6; 1 {
		let eangle = randomRange(-18000,18000)/100.0;
		let edir = rad($eangle);
		let espeed = randomRange(0,1000)/100.0;
		explod{anim: 100051; ID: 100051; pos: 0,-50; postype: p1; facing: 1; bindtime: 0; vel: $espeed*sin($edir),$espeed*cos($edir); removetime: -2; pausemovetime: -1; supermovetime: -1; scale: randomRange(100,3000)/100.0,randomRange(100,400)/100.0; angle: $eangle-90; ontop: 1; shader: "trans_rights"; shadertime: -1; ownpal: 1; ignorehitpause: 1;}
	}
	for i = 1; 6; 1 {
		let eangle = randomRange(-18000,18000)/100.0;
		let edir = rad($eangle);
		let espeed = randomRange(0,1000)/100.0;
		explod{anim: 100052; ID: 100052; pos: 0,-50; postype: p1; facing: 1; bindtime: 0; vel: $espeed*sin($edir),$espeed*cos($edir); removetime: -2; pausemovetime: -1; supermovetime: -1; scale: randomRange(100,3000)/100.0,randomRange(100,400)/100.0; angle: $eangle-90; ontop: 1;shader: "trans_rights"; shadertime: -1; ownpal: 1; ignorehitpause: 1;}
	}
}

if pos y < 0 || stateType = A {
	changeAnim{value: 5030;}
	if hitShakeOver {
		velSet{x: -5; y: -7-(0.25*!time);}
		sysFVar(35) := 0.25;
		guardBreakSet{value: 0}
		map(SokuGetHitType) := -1;
		getHitVarSet{fall: 1; fall.recover: 0; yaccel: 0.25;}
		changeState{value: 5050;}
	}
} else if !hitShakeOver {
	changeAnim{value: 5300;}
} else {
	persistent(0) {velSet{x: -6-(0.3*!time);}}
	velSet{x: min(0,vel X+0.3);}
	if !animTime {
		guardBreakSet{value: 0}
		changeState{value: const(StateGuardBreakRecover); ctrl: 0;}
	}
}

[StateDef const(StateGuardBreakRecover); type: S; movetype: I; physics: N; anim: 5301; ctrl: 0;]

if !animTime {
	changeState{value: 0; ctrl: 1;}
}

[StateDef 5600; type: A; movetype: H; physics: N; anim: 5030; ctrl: 0; velset: 0,0;]

changeAnim{value: 5030;}

if time = 3 {
	turn{}
	changeAnim{value: 5030; elem: 2;}
	getHitVarSet{animtype: 3; yaccel: 0.25; xvel: -2.5*facing; yvel: -1.75; fall.xvel: -1.25;}
	selfState{value: 5030; ctrl: 0;}
}

#===============================================================================
# PostUpdate
#===============================================================================
[StateDef 1211920;
type: S; movetype: H; physics: N;
anim: 9999; ctrl: 0; velset: 0, 0;]
ignoreHitPause {

let rootID = root,ID;

assertSpecial{flag: RunLast;}
notHitBy{attr: SCA,AA,AP,AT; time: -1;}

if roundTime > 0 {

if !root,numExplod(200100) {
	explod{id: 200100; anim: 200100; animfreeze: 1; animelem: 1; pos: cond(teamSide = 2,screenWidth-5,5),screenHeight-44; postype: left; layerno: 1; sprpriority: 5; bindtime: -1; facing: cond(teamSide = 2,-1,1); removetime: -1; scale: 0.5,0.5; supermovetime: -1; pausemovetime: -1; ownpal: 1; redirectid: $rootID;}
}

if power = [1,499] {
	if !root,numExplod(200102) {
		explod{id: 200102; anim: 200100; animfreeze: 1; animelem: 4; postype: left; layerno: 1; sprpriority: 6; bindtime: -1; facing: cond(teamSide = 2,-1,1); removetime: -1; scale: 0.5,0.5; supermovetime: -1; pausemovetime: -1; ownpal: 1; redirectid: $rootID;}
	}
	modifyExplod{id: 200102; animelem: 4; pos: cond(teamSide = 2,screenWidth-6,6),screenHeight-43; window: 0,32.5-(32.5*float(power)/500),20.5,32.5; redirectid: $rootID;}
} else if power = [501,2499] {
	if !root,numExplod(200102) {
		explod{id: 200102; anim: 200100; animfreeze: 1; animelem: 5; postype: left; layerno: 1; sprpriority: 6; bindtime: -1; facing: cond(teamSide = 2,-1,1); removetime: -1; scale: 0.5,0.5; supermovetime: -1; pausemovetime: -1; ownpal: 1; redirectid: $rootID;}
	}
	modifyExplod{id: 200102; animelem: 5; pos: cond(teamSide = 2,screenWidth-29.5-(10.5*(floor(power/500)-1)),29.5+(10.5*(floor(power/500)-1))),screenHeight-(26.5-(2*(floor(power/500)-1))); window: 0,13.5-(13.5*float(power%500)/500),8.5,13.5; redirectid: $rootID;}
}

if root,power >= 500 {
	if !root,numExplod(200101) {
		explod{id: 200101; anim: 200100; animfreeze: 1; animelem: 1+teamSide; pos: cond(teamSide = 2,screenWidth-6,6),screenHeight-43; postype: left; layerno: 1; sprpriority: 7; bindtime: -1; facing: cond(teamSide = 2,-1,1); removetime: -1; scale: 0.5,0.5; supermovetime: -1; pausemovetime: -1; ownpal: 1; redirectid: $rootID;}
	}
	modifyExplod{id: 200101; window: 0,0,21.5+(10.5*(floor(power/500)-1)),36; redirectid: $rootID;}
} else {
	if root,numExplod(200101) {
		removeExplod{id: 200101; redirectid: $rootID;}
	}
}

if !root,numExplod(200000) {
	explod{id: 200000; anim: 200000; animfreeze: 1; pos: cond(teamSide = 2,screenWidth-77.5,77.5),screenHeight-20.5; postype: left; layerno: 1; sprpriority: 5; bindtime: -1; facing: cond(teamSide = 2,-1,1); removetime: -1; scale: 0.5,0.5; supermovetime: -1; pausemovetime: -1; ownpal: 1; redirectid: $rootID;}
}
modifyExplod{id: 200000; animelem: 1+floor(root,map(SokuBorderBreaks)); redirectid: $rootID;}

if !root,numExplod(200001) {
	explod{id: 200001; anim: 200000; animelem: 7; animfreeze: 1; pos: cond(teamSide = 2,screenWidth-77.5,77.5),screenHeight-20.5; postype: left; layerno: 1; sprpriority: 6; bindtime: -1; facing: cond(teamSide = 2,-1,1); removetime: -1; scale: 0.5,0.5; supermovetime: -1; pausemovetime: -1; ownpal: 1; redirectid: $rootID;}
}
modifyExplod{id: 200001; window: 0,0,13.8*floor(root,guardPoints/200),17.5; redirectid: $rootID;}

if !root,numExplod(200002) {
	explod{id: 200002; anim: 200000; animelem: 8; animfreeze: 1; postype: left; layerno: 1; sprpriority: 7; bindtime: -1; facing: cond(teamSide = 2,-1,1); removetime: -1; scale: 0.5,0.5; supermovetime: -1; pausemovetime: -1; ownpal: 1; redirectid: $rootID;}
}
modifyExplod{id: 200002; pos: cond(teamSide = 2,screenWidth-66-(13.5*floor(root,guardPoints/200+1)),66+(13.5*floor(root,guardPoints/200+1))),screenHeight-cond(floor(root,guardPoints/200+1)%2,19,15.5); window: -1,-1,11.0*((root,guardPoints%200)/200.0),11; redirectid: $rootID;}

if !root,numExplod(200003) {
	explod{id: 200003; anim: 200000; animelem: 9; animfreeze: 1; postype: left; layerno: 1; sprpriority: 7; bindtime: -1; facing: cond(teamSide = 2,-1,1); removetime: -1; scale: 0.5,0.5; supermovetime: -1; pausemovetime: -1; ownpal: 1; redirectid: $rootID;}
}
modifyExplod{id: 200003; pos: cond(teamSide = 2,screenWidth-66-(13.5*floor(6-root,map(SokuBorderBreaks))),66+(13.5*floor(6-root,map(SokuBorderBreaks)))),screenHeight-cond(floor(6-root,map(SokuBorderBreaks))%2,19,15.5); window: -1,11.0-(11.0*(root,map(SokuBorderBreakRecovery)/4800)),11,11; redirectid: $rootID;}

}

for i = cond(teamSide%2,2,1); (enemy,numPartner+1)*2 - (1-(teamSide%2)); 2 {
	let charID = player($i),ID;
	if player($i),moveType != H || player($i),ctrl || player($i),stateNo = 5150 {
		mapSet{map: "SokuComboLimit"; value: 0; redirectid: $charID;}
		mapSet{map: "SokuComboRate"; value: 1; redirectid: $charID;}
		mapSet{map: "SokuGetHitType"; value: 0; redirectid: $charID;}
		mapSet{map: "SokuModifierHits"; value: 0; redirectid: $charID;}
	}
	if player($i),map(SokuGetHitType) = 3 && player($i),getHitVar(playerno) = playerno {
		if player($i),stateNo = 5101 {
			changeState{value: 5050; ctrl: 0; redirectid: $charID; continue: 1;}
			mapSet{map: "SokuGetHitType"; value: 1; redirectid: $charID;}
			getHitVarSet{yaccel: 0.125; fallcount: 0; down.recovertime: player($i),const(data.liedown.time); redirectid: $charID;}
		}
		if !player($i),animElemVar(numclsn2) {
			overrideClsn{group: clsn2; rect: -50,-50,50,50; redirectid: $charID;}
		}
		if player($i),stateType = L {
			stateTypeSet{statetype: A; redirectid: $charID;}
		}
	}
	if player($i),map(SokuBorderCooldown) > 0 {
		mapSet{map: "_iksys_guardPointsTimer"; value: player($i),map(SokuBorderCooldown); redirectid: $charID;}
		mapSet{map: "SokuBorderCooldown"; value: 0; redirectid: $charID;}
	}
	if player($i),map(SokuComboLimit) >= 100 {
		getHitVarSet{fall.recover: 0; redirectid: $charID;}
		notHitBy{attr: SCA,AA,AP,AT; time: 1; slot: 7; redirectid: $charID;}
	} else if player($i),hitFall && player($i),canRecover {
		notHitBy{attr: SCA,AA,AP,AT; time: 1; slot: 7; redirectid: $charID;}
	}
	if player($i),authorName = "nns" && player($i),moveType = A && player($i),time < 10 {
		hitBy{value2: SCA,AA,AP,AT; time: 0; redirectid: $charID;}
		for h = player($i),numHelper; 1; -1 {
			let helpID = player($i),helperIndex($h),ID;
			if playerId($helpID),stateNo = 13000 {
				destroySelf{removeexplods: 1; recursive: 1; redirectid: $helpID}
			}
		}
	}
}

let madehelper = 0;
for i = 0; numPlayer - 1; 1 {
	let charID = playerIndex($i),ID;
	for p = root,numProj-1; 0; -1 {
		if root,numHelper >= $rootID-4 {
			break;
		}
		let projvelx = root,projVar(-1, $p, vel X)*root,projVar(-1, $p, facing);
		let projvely = root,projVar(-1, $p, vel Y);
		modifyProjectile{index: $p; offset: $projvelx,$projvely; redirectid: $rootID;}
		if root,projVar(-1, $p, projhits) > 0 && playerIndex($i),teamSide != root,projVar(-1, $p, teamside) && root,projClsnOverlap($p, $charID, clsn2) {
			modifyProjectile{index: $p; offset: -$projvelx,-$projvely; redirectid: $rootID;}
			let projid = root,projVar(-1, $p, projid);
			let didhandle = 0;
			switch $projid {
			case 1304:
				let didhandle = 1;
				let madehelper = 1;
				helper{id: 1304; stateno: 1304; pos: root,projVar(-1, $p, pos X)+camerapos X,root,projVar(-1, $p, pos Y); postype: none; facing: root,projVar(-1, $p, facing); ownpal: 1; inheritjuggle: 1; map.ZenithClashDNPH: 1; map.ZenithClashDNHH: 1; map.ZenithClashPoints: 1; inheritchannels: 1; map.VelX: root,projVar(-1, $p, vel X); map.VelY: root,projVar(-1, $p, vel Y); map.RemoveTime: root,projVar(-1, $p, projremovetime)-12; redirectid: $rootID;}
				changeAnim{value: root,projVar(-1, $p, anim); elem: root,projVar(-1, $p, animelem); redirectid: lastPlayerID;}
				notHitBy{value: SCA,AA,AP,AT; time: -1; redirectid: lastPlayerID;}
			}
			if $didhandle {
				modifyProjectile{index: $p; projid: -1; redirectid: $rootID;}
			}
			continue;
		}
		modifyProjectile{index: $p; offset: -$projvelx,-$projvely; redirectid: $rootID;}
	}
	if root,map(IsSokuGrazing) {
		for p = 0; playerIndex($i),numProj-1; 1 {
			let projvelx = playerIndex($i),projVar(-1, $p, vel X)*playerIndex($i),projVar(-1, $p, facing);
			let projvely = playerIndex($i),projVar(-1, $p, vel Y);
			let handled = 0;
			modifyProjectile{index: $p; offset: $projvelx,$projvely; redirectid: $charID;}
			if playerIndex($i),projVar(-1, $p, teamside) != root,teamSide && playerIndex($i),projVar(-1, $p, projhits) && playerIndex($i),projVar(-1, $p, attr) = SCA,AP && playerIndex($i),projClsnOverlap($p, $rootID, clsn2) {
				modifyProjectile{index: $p; offset: -$projvelx,-$projvely; redirectid: $charID;}
				let handled = 1;
				let sparkx = playerIndex($i),projVar(-1, $p, pos X);
				let sparky = playerIndex($i),projVar(-1, $p, pos Y);
				let rootleft = min(root,clsnVar(size, 0, front)*root,facing, root,clsnVar(size, 0, back)*root,facing)+root,pos X;
				let rootright = max(root,clsnVar(size, 0, front)*root,facing, root,clsnVar(size, 0, back)*root,facing)+root,pos X;
				let roottop = root,pos Y+root,groundLevel;
				let rootbot = root,clsnVar(size, 0, bottom)+$roottop;
				let roottop = root,clsnVar(size, 0, top)+$roottop;
				let sparkx = cond($sparkx < $rootleft,$rootleft,cond($sparkx > $rootright,$rootright,$sparkx))+cameraPos X;
				let sparky = cond($sparky < $roottop,$roottop,cond($sparky > $rootbot,$rootbot,$sparky));
				for particle = 0; 1; 1 {
					let escale = randomRange(100,200)/100.0;
					let eangle = randomRange(-18000,18000)*pi/18000.0;
					let espeed = randomRange(400,1000)/100.0;
					explod{anim: 100050; ID: 100050; pos: $sparkx,$sparky; postype: none; bindtime: 0; vel: $espeed*sin($eangle),$espeed*cos($eangle); removetime: -2; pausemovetime: -1; supermovetime: -1; scale: $escale,$escale; ontop: 1; shader: "trans_rights"; shadertime: -1; ownpal: 1; ignorehitpause: 1;}
				}
				playSnd{value: S100,10; abspan: $sparkx-cameraPos X; volumescale: 200; channel: 10; redirectid: $rootID}
				if playerIndex($i),projVar(-1, $p, projpriority) < 4 {
					let projhits = playerIndex($i),projVar(-1, $p, projhits)-1;
					if $projhits = 0 {
						let projhits = -1;
					}
					modifyProjectile{index: $p; projhits: $projhits; redirectid: $charID;}
				}
			}
			if !$handled {modifyProjectile{index: $p; offset: -$projvelx,-$projvely; redirectid: $charID;}}
		}
		if playerIndex($i),teamSide = root,teamSide || playerIndex($i),hitDefAttr != SCA,AP || playerIndex($i),hitDefAttr = SCA,AA,AT {continue;}
		let GrazeCost = round(playerIndex($i),map(GrazeCost),0);
		if playerIndex($i),clsnOverlap(clsn1, $rootID, clsn2) {
			let GrazeFail = $GrazeCost > 0 && $GrazeCost >= root,guardPoints;
			if playerIndex($i),map(Ungrazable) || $GrazeFail {
				for i = 0; 7; 1 {
					hitBy{attr: SCA,AA,AP,AT; time: 0; slot: $i; redirectid: $rootID}
					mapSet{map: "IsSokuGrazing"; value: 0; redirectid: $rootID}
				}
				if $GrazeFail {guardPointsSet{value: 0; redirectid: $rootID}}
			} else {
				guardPointsAdd{value: -$GrazeCost; redirectid: $rootID}
				mapSet{map: "GotGrazed"; value: 1; redirectid: $charID}
				let sparkx = playerIndex($i),pos X+(playerIndex($i),hitDefVar(sparkx)*playerIndex($i),facing);
				let sparky = playerIndex($i),pos Y+playerIndex($i),groundLevel+playerIndex($i),hitDefVar(sparky);
				let rootleft = min(root,clsnVar(size, 0, front)*root,facing, root,clsnVar(size, 0, back)*root,facing)+root,pos X;
				let rootright = max(root,clsnVar(size, 0, front)*root,facing, root,clsnVar(size, 0, back)*root,facing)+root,pos X;
				let roottop = root,pos Y+root,groundLevel;
				let rootbot = root,clsnVar(size, 0, bottom)+$roottop;
				let roottop = root,clsnVar(size, 0, top)+$roottop;
				let sparkx = cond($sparkx < $rootleft,$rootleft,cond($sparkx > $rootright,$rootright,$sparkx))+cameraPos X;
				let sparky = cond($sparky < $roottop,$roottop,cond($sparky > $rootbot,$rootbot,$sparky));
				for p = 0; 1; 1 {
					let escale = randomRange(100,200)/100.0;
					let eangle = randomRange(-18000,18000)*pi/18000.0;
					let espeed = randomRange(400,1000)/100.0;
					explod{anim: 100050; ID: 100050; pos: $sparkx,$sparky; postype: none; bindtime: 0; vel: $espeed*sin($eangle),$espeed*cos($eangle); removetime: -2; pausemovetime: -1; supermovetime: -1; scale: $escale,$escale; ontop: 1; shader: "trans_rights"; shadertime: -1; ownpal: 1; ignorehitpause: 1;}
				}
				playSnd{value: S100,10; abspan: $sparkx-cameraPos X; volumescale: 200; channel: 10; redirectid: $rootID}
			}
		}
	}
	assertSpecial{flag: NoFallDefenceUp; flag2: NoKoVelocity; flag3: NoKoFall; redirectid: $charID;}
	if playerIndex($i),teamSide != root,teamSide && root,isAsserted(playerpush) && playerIndex($i),isAsserted(playerpush) && root,clsnOverlap(size, $charID, size) {
		let ff = sign(playerIndex($i),pos X+(playerIndex($i),distOffset X*playerIndex($i),facing)-(root,pos X+(root,distOffset X*root,facing)));
		let p1c = 0.0;
		let p2c = 0.0;
		if $ff = 0 {
			push{redirectid: $charID;}
			let ff = sign(playerIndex($i),pos X+(playerIndex($i),distOffset X*playerIndex($i),facing)-(root,pos X+(root,distOffset X*root,facing)));
		}
		if $ff = root,facing {
			let p1c = root,clsnVar(size, 0, front)*root,facing;
		} else {
			let p1c = root,clsnVar(size, 0, back)*root,facing;
		}
		if $ff != playerIndex($i),facing {
			let p2c = playerIndex($i),clsnVar(size, 0, front)*playerIndex($i),facing;
		} else {
			let p2c = playerIndex($i),clsnVar(size, 0, back)*playerIndex($i),facing;
		}
		let l = 0;
		while $l < 300 && abs(playerIndex($i),pos X + $p2c - root,pos X - $p1c) > 0.01
		{
			push{redirectid: $charID;}
			let l = $l+1;
		}
	}
}

if !root,spriteVar(height) {
	changeAnim{value: 0; redirectid: $rootID;}
}

if $madehelper {
	helper{name: "PostUpdate"; id: 1211920; stateno: 1211920; supermovetime: -1; pausemovetime: -1; redirectid: $rootID;}
	destroySelf{removeexplods: 1;}
}

}

[StateDef +1]
if !pauseTime {

if map(GrazeTime) > 0 {
	if hitByAttr(SCA,AP) {map(IsSokuGrazing) := 1;}
	notHitBy{attr: ,AP; time: 1; slot: 1;}
	map(GrazeTime) := map(GrazeTime)-1;
}

ignoreHitPause if numExplod(10150) && anim != [150,152] {
	explod{id: 10151; anim: 10150; animelem: explodVar(10150,0,animelem);
		pos: (explodVar(10150,0,pos X)-pos X)*facing,explodVar(10150,0,pos Y)-pos Y;
		postype: P1;
		sprpriority: sprPriority+1;
		bindtime: 0;
		removetime: 13;
		trans: add;
		alpha: 256,256;
		interpolation.time: 13;
		interpolation.alpha: 0,256;
		scale: 1.5,1.5;
		supermovetime: 0;
		pausemovetime: 0;
		ignorehitpause: 1;
		ownpal: 1;
		shader: "trans_rights";
		shadertime: -1;}
	removeExplod{id: 10150;}
}

ignoreHitPause if (moveType = H && anim != 150 && anim != 152) || inCustomState {map(NoElectron) := 1;}

if !isHelper && !inCustomState {

ignoreHitPause {
	displayToClipboard{text:"vel x = %f, vel y = %f"; params: vel X, vel Y;}
}

if getHitVar(frame) && moveType = H {
	call ActionStart(0);
}

if !ctrl {
	if map(CanMotionCancel) && stateType != A && command = "holdup" {
		call ActionStart(1);
