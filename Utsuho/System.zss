[Function ActionStart(ActionLock)]
map(ActionLock) := $ActionLock;
map(CanActionCancel) := 0;
map(CanMotionCancel) := 0;
map(CanGuard) := 0;

[Function HitEffect(Effect, charID)]
let sparkx = playerId($charID),moveHitVar(sparkx);
let sparky = playerId($charID),moveHitVar(sparky);
let numbluebeams = 0;
let numredbeams = 0;
let numparticles = 0;

explod{id: 9999+floor($Effect); anim: 9999+floor($Effect); facing: 1; pos: $sparkx,$sparky; postype: P1; angle: randomRange(-18000,18000)/100.0; ontop: 1; bindtime: 0; removetime: -2; supermovetime: -1; pausemovetime: -1; shader: "trans_rights"; shadertime: -1; ownpal: 1; ignorehitpause: 1; redirectid: $charID;}

switch $Effect {
	case 1:
		let numparticles = 3;
	case 2:
		let numparticles = 6;
		let numbluebeams = 3;
		let numredbeams = 3;
	case 3:
		explod{id: 10053; anim: 10053; facing: 1; pos: $sparkx,$sparky; postype: P1; ontop: 1; bindtime: 0; removetime: -2; supermovetime: -1; pausemovetime: -1; shader: "trans_rights"; shadertime: -1; ownpal: 1; ignorehitpause: 1; palfx.time: -1; palfx.mul: 256,256,256; interpolation.time: 12; interpolation.palfx.mul: 0,0,256; redirectid: $charID;}
		let numparticles = 6;
		let numbluebeams = 6;
		let numredbeams = 6;
	case 4:
		explod{id: 10054; anim: 10054; facing: 1; pos: $sparkx,$sparky; postype: P1; ontop: 1; bindtime: 0; removetime: -2; supermovetime: -1; pausemovetime: -1; shader: "trans_rights"; shadertime: -1; ownpal: 1; ignorehitpause: 1; palfx.time: -1; palfx.mul: 256,256,256; interpolation.time: 12; interpolation.palfx.mul: 0,0,256; redirectid: $charID;}
		let numparticles = 6;
		let numbluebeams = 6;
		let numredbeams = 6;
#	case 5:
#	case 6:
#	case 7:
#	case 8:
#	case 9:
#	case 10:
#	case 11:
#	case 12:
	case 13:
		explod{id: 10062; anim: 10062; facing: 1; pos: $sparkx,$sparky; postype: P1; ontop: 1; bindtime: 0; removetime: -2; supermovetime: -1; pausemovetime: -1; shader: "trans_rights"; shadertime: -1; ownpal: 1; ignorehitpause: 1; palfx.time: -1; palfx.mul: 256,256,256; interpolation.time: 16; interpolation.palfx.mul: 0,0,256; redirectid: $charID;}
		let numbluebeams = 4;
#	case 14:
#	case 15:
#	case 16:
}

for i = 1; $numparticles; 1 {
	let escale = randomRange(0,100)/100.0;
	let eangle = randomRange(-18000,18000)*pi/18000.0;
	let espeed = randomRange(400,1000)/100.0;
	explod{anim: 10050; ID: 10050; pos: $sparkx,$sparky; postype: p1; facing: 1; bindtime: 0; vel: $espeed*sin($eangle),$espeed*cos($eangle); removetime: -2; pausemovetime: -1; supermovetime: -1; scale: $escale,$escale; ontop: 1; shader: "trans_rights"; shadertime: -1; ownpal: 1; ignorehitpause: 1; redirectid: $charID;}
}

for i = 1; $numbluebeams; 1 {
	let eangle = randomRange(-18000,18000)/100.0;
	let edir = rad($eangle);
	let espeed = randomRange(0,1000)/100.0;
	explod{anim: 10051; ID: 10051; pos: $sparkx,$sparky; postype: p1; facing: 1; bindtime: 0; vel: $espeed*sin($edir),$espeed*cos($edir); removetime: -2; pausemovetime: -1; supermovetime: -1; scale: randomRange(100,3000)/100.0,randomRange(100,400)/100.0; angle: $eangle-90; ontop: 1; shader: "trans_rights"; shadertime: -1; ownpal: 1; ignorehitpause: 1; redirectid: $charID;}
}

for i = 1; $numredbeams; 1 {
	let eangle = randomRange(-18000,18000)/100.0;
	let edir = rad($eangle);
	let espeed = randomRange(0,1000)/100.0;
	explod{anim: 10052; ID: 10052; pos: $sparkx,$sparky; postype: p1; facing: 1; bindtime: 0; vel: $espeed*sin($edir),$espeed*cos($edir); removetime: -2; pausemovetime: -1; supermovetime: -1; scale: randomRange(100,3000)/100.0,randomRange(100,400)/100.0; angle: $eangle-90; ontop: 1;shader: "trans_rights"; shadertime: -1; ownpal: 1; ignorehitpause: 1; redirectid: $charID;}
}

#===============================================================================
# PreUpdate
#===============================================================================
[StateDef 1618521;
type: S; movetype: I; physics: N;
anim: 9999; ctrl: 0; velset: 0, 0;]
ignoreHitPause {

assertSpecial{flag: RunFirst;}
notHitBy{attr: SCA,AA,AP,AT; time: 1; slot: 0;}
overrideClsn{group: size; index: 0; rect: 0, 0, 0, 0;}

for i = cond(teamSide%2,2,1); (enemy,numPartner+1)*2 - (1-(teamSide%2)); 2 {
	let charID = player($i),ID;
	if player($i),moveType = H && player($i),stateNo != 5150 {
		if player($i),getHitVar(frame) {
			if !player($i),getHitVar(guarded) {
				let prevrate = 1.0;
				let origdamagecalc = 0;
				let finaldamagecalc = 0;
				let hashit = 0;
				let ro = 0;
				for h = root,numHelper; 0; -1 {
					if root,helperIndex($h),moveHitVar(frame) && root,helperIndex($h),moveHit && root,helperIndex($h),hasHit($charID) {
						let origdamage = round(root,helperIndex($h),hitDefVar(hitdamage)*root,helperIndex($h),attack/player($i),defence, 0);
						let origdamagecalc = $origdamagecalc+$origdamage;
						if player($i),map(SokuComboLimit) < 100 {
							let finaldamagecalc = $finaldamagecalc+round($origdamage*player($i),map(SokuComboRate)*lerp(0.7, 1, float(player($i),life-$finaldamagecalc)/player($i),lifeMax), 0);
							let prevrate = player($i),map(SokuComboRate);
							mapSet{map: "SokuComboLimit"; value: player($i),map(SokuComboLimit)+root,helperIndex($h),map(LimitGain); redirectid: $charID;}
							if player($i),map(SokuComboLimit) >= 100 {
								#getHitVarSet{damage: 0; redirectid: $charID;}
								explod{id: 15400; anim: 15400; facing: player($i),facing*facing; pos: 0,-50; postype: P1; sprpriority: 0; bindtime: -1; bindid: $charID; removetime: -1; scale: 2.45,2.45; interpolation.time: 7; interpolation.scale: 1,1; supermovetime: -1; pausemovetime: -1; shader: "trans_rights"; shadertime: -1; ownpal: 1; ignorehitpause: 1;}
								modifyExplod{id: 15400; index: numExplod(15400)-1; bindid: $charID;}
								explod{id: 15400; anim: 15401; facing: player($i),facing*facing; pos: 0,-50; postype: P1; sprpriority: 0; bindtime: -1; bindid: $charID; removetime: -1; supermovetime: -1; pausemovetime: -1; shader: "trans_rights"; shadertime: -1; ownpal: 1; ignorehitpause: 1;}
								modifyExplod{id: 15400; index: numExplod(15400)-1; bindid: $charID;}
							}
							mapSet{map: "SokuComboRate"; value: player($i),map(SokuComboRate)*root,helperIndex($h),map(Proration); redirectid: $charID;}
						}
						if player($i),getHitVar(playerno) = playerNo && root,helperIndex($h),runOrder >= $ro {
							mapSet{map: "SokuGetHitType"; value: root,helperIndex($h),map(SokuHitType); redirectid: $charID;}
							mapSet{map: "SokuFriction"; value: root,helperIndex($h),map(SokuHitFriction); redirectid: $charID;}
							let ro = root,helperIndex($h),runOrder;
						}
					}
				}
				powerAdd{value: floor($finaldamagecalc*0.5*(1000.0/player($i),lifeMax)); redirectid: $charID;}
				getHitVarSet{damage: player($i),getHitVar(hitdamage)-$origdamagecalc+$finaldamagecalc; redirectid: $charID;}
				if player($i),hitFall {
					getHitVarSet{fall.recovertime: (player($i),getHitVar(fall.recovertime)-player($i),getHitVar(HitShakeTime))*$prevrate + player($i),getHitVar(HitShakeTime); redirectid: $charID;}
				}
				if sign(root,pos X-player($i),pos X) != player($i),facing {
					turn{redirectid: $charID;}
				}
			}
			if sign(player($i),pos X-root,pos X) != root,facing {
				getHitVarSet{xvel: -player($i),getHitVar(xvel); redirectid: $charID;}
			}
		}
		if player($i),getHitVar(playerno) = playerNo && !player($i),pauseTime && !player($i),inCustomState && player($i),hitShakeOver {
			if player($i),stateType = S || player($i),stateType = C {
				let xvel = player($i),vel X;
				let dir = sign($xvel);
				if player($i),getHitVar(guarded) {
					velSet{x: max(0,abs($xvel)-0.3)*$dir; redirectid: $charID;}
				} else {
					velSet{x: max(0,abs($xvel)-player($i),map(SokuFriction))*$dir; redirectid: $charID;}
				}
			} else if !player($i),getHitVar(guarded) && player($i),stateType != L {
				let SokuGetHitType = player($i),map(SokuGetHitType);
				if $SokuGetHitType != 3 {
					getHitVarSet{fall.yvel: player($i),vel Y/-2; redirectid: $charID;}
				}
				if !$SokuGetHitType && player($i),getHitVar(yaccel) = 0.25 && player($i),hitFall && player($i),vel Y <= 0 {
					velAdd{y: 0.25; redirectid: $charID;}
				} else if $SokuGetHitType = 2 && player($i),backEdgeBodyDist <= 0 {
					selfState{value: 5600; ctrl: 0; continue: 1; readplayerid: root,ID; redirectid: $charID;}
					playSnd{value: S52,1; volumescale: 200; abspan: player($i),pos X;}
					explod{id: 15100; anim: 15100; pos: gameWidth/2.0*sign(player($i),pos X)+camerapos X,player($i),pos Y+player($i),groundLevel-50; postype: none; sprpriority: 0; bindtime: 0; facing: 1; removetime: -2; supermovetime: -1; pausemovetime: -1; ownpal: 1; yangle: -80; shader: "trans_rights"; shadertime: -1;}
					mapSet{map: "SokuGetHitType"; value: -1; redirectid: $charID;}
				}
			}
		}
		if player($i),getHitVar(playerid) = root,ID && (player($i),map(SokuGetHitType) != 2 || player($i),getHitVar(guarded)) && player($i),backEdgeBodyDist+player($i),vel X <= 0 {
			mapSet{map: "DoSokuCornerPush"; value: cond(player($i),stateType = A,3,1+player($i),getHitVar(guarded)); redirectid: root,ID;}
		}
	}
}

for i = 0; root,numHelper; 1 {
	if root,helperIndex($i),map(SokuHitEffect) > 0 && root,helperIndex($i),moveHitVar(frame) && root,helperIndex($i),moveHit {
		if root,helperIndex($i),map(ZenithClashNonCompat) {
			for en = cond(teamSide%2,2,1); (enemy,numPartner+1)*2 - (1-(teamSide%2)); 2 {
				if player($en),getHitVar(frame) && !player($en),getHitVar(guarded) && root,helperIndex($i),hasHit(player($en),ID) {
					call HitEffect(root,helperIndex($i),map(SokuHitEffect), root,helperIndex($i),ID);
				}
			}
		} else {
			call HitEffect(root,helperIndex($i),map(SokuHitEffect), root,helperIndex($i),ID);
		}
	}
}

for i = numExplod(15400)-1; 0; -1 {
	let charID = explodVar(15400, $i, bindid);
	if playerId($charID),map(SokuComboLimit) < 100 {
		explod{id: 15401; anim: explodVar(15400, $i, anim); animelem: explodVar(15400, $i, animelem); animelemtime: explodVar(15400, $i, animelemtime); facing: explodVar(15400, $i, facing)*facing; pos: 0,-50; postype: P1; sprpriority: 0; bindtime: -1; removetime: 13; trans: add; alpha: 256,256; palfx.time: -1; palfx.mul: 256,256,256; interpolation.time: 13; interpolation.alpha: 0,256; interpolation.palfx.mul: 0,0,256; supermovetime: -1; pausemovetime: -1; shader: "trans_rights"; shadertime: -1; ownpal: 1; ignorehitpause: 1;}
		modifyExplod{id: 15401; index: numExplod(15401)-1; bindid: $charID;}
		removeExplod{id: 15400; index: $i;}
	} else {
		let expscl = 1.1+(sin((360+explodVar(15400, $i, animtime))*pi/60)*0.1);
		if explodVar(15400, $i, anim) = 15400 {
			let expscl = $expscl*0.9;
		}
		modifyExplod{id: 15400; index: $i; scale: $expscl,$expscl;}
	}
}

for i = 0; numExplod(15401)-1; 1 {
	let expscl = 1.1+(sin((360+explodVar(15401, $i, animtime))*pi/60)*0.1);
	if explodVar(15401, $i, anim) = 15400 {
		let expscl = $expscl*0.9;
	}
	modifyExplod{id: 15401; index: $i; scale: $expscl,$expscl;}
}

}

[StateDef -4]
ignoreHitPause {

if isHelper {
	if enemyNear,name = "Flandre_Scarlet" {
		map(BasePriority) := 5;
	} else {map(BasePriority) := 4;}
}

if isHelper(1211920) {
	for i = numPlayer-1; 0; -1 {
		if playerIndex($i),ID = ID {break;}
		if playerIndex($i),runOrder > runOrder && !playerIndex($i),isHelper(1211920) {
			helper{name: "PostUpdate"; id: 1211920; stateno: 1211920; supermovetime: -1; pausemovetime: -1; redirectid: root,ID;}
			destroySelf{}
		}
	}
}

assertSpecial{flag: NoJump; flag2: NoStandGuard; flag3: NoCrouchGuard; flag4: NoAirGuard; flag5: NoIntroReset;}

if inputtime(a) > 0 {
	if command = "8a" {assertCommand{name: "8a"; buffer.time: max(8-inputtime(a), 2);}}
	if command = "6a" {assertCommand{name: "6a"; buffer.time: max(8-inputtime(a), 2);}}
	if command = "4a" {assertCommand{name: "4a"; buffer.time: max(8-inputtime(a), 2);}}
	if command = "1a" {assertCommand{name: "1a"; buffer.time: max(8-inputtime(a), 2);}}
	if command = "3a" {assertCommand{name: "3a"; buffer.time: max(8-inputtime(a), 2);}}
	if command = "2a" {assertCommand{name: "2a"; buffer.time: max(8-inputtime(a), 2);}}
	if command = "a" {assertCommand{name: "a"; buffer.time: max(8-inputtime(a), 2);}}
}

if inputtime(b) > 0 {
	if command = "b" {assertCommand{name: "b"; buffer.time: max(8-inputtime(b), 2);}}
}

if inputtime(c) > 0 {
	if command = "c" {assertCommand{name: "c"; buffer.time: max(8-inputtime(c), 2);}}
	if command = "6c" {assertCommand{name: "6c"; buffer.time: max(8-inputtime(c), 2);}}
	if command = "4c" {assertCommand{name: "4c"; buffer.time: max(8-inputtime(c), 2);}}
	if command = "2c" {assertCommand{name: "2c"; buffer.time: max(8-inputtime(c), 2);}}
}

if !isHelper {

if introState || roundState != 2 {
	notHitBy{attr: SCA,AA,AP,AT; time: 1; slot: 5;}
}

map(NoElectron) := 0;

if !numHelper(10990) {
	helper{name: "ElectronPos"; id: 10990; stateno: 10990; supermovetime: 0; pausemovetime: 0;}
}

if !numHelper(1211920) {
	helper{name: "PostUpdate"; id: 1211920; stateno: 1211920; supermovetime: -1; pausemovetime: -1;}
	assertSpecial{flag: RunLast; redirectid: lastPlayerID;}
}

if !numHelper(1618521) {
	helper{name: "PreUpdate"; id: 1618521; stateno: 1618521; supermovetime: -1; pausemovetime: -1;}
}

}

}

[StateDef -2]

if map(DoSokuCornerPush) = 1 {
	posAdd{x: map(SokuCornerPush)*facing;}
} else if map(DoSokuCornerPush) = 2 {
	posAdd{x: map(SokuGuardCornerPush)*facing;}
} else if map(DoSokuCornerPush) = 3 {
	posAdd{x: map(SokuAirCornerPush)*facing;}
}

map(SokuCornerPush) := max(0, abs(map(SokuCornerPush))-map(SokuCornerPushDecel))*sign(map(SokuCornerPush));
map(SokuGuardCornerPush) := max(0, abs(map(SokuGuardCornerPush))-map(SokuGuardCornerPushDecel))*sign(map(SokuGuardCornerPush));
map(SokuAirCornerPush) := max(0, abs(map(SokuAirCornerPush))-1)*sign(map(SokuAirCornerPush));

if !map(SokuCornerPush) && !map(SokuGuardCornerPush) && !map(SokuAirCornerPush) {
	map(DoSokuCornerPush) := 0;
}

[StateDef 5600; type: A; movetype: H; physics: N; anim: 5030; ctrl: 0; velset: 0,0;]

changeAnim{value: 5030; elem: 1; elemtime: animElemVar(time)-1;}

if time = 3 {
	turn{}
	getHitVarSet{animtype: 3; yaccel: 0.25; xvel: -2.5*facing; yvel: -1.75; fall.xvel: -1.25;}
	selfState{value: 5030; ctrl: 0;}
}

#===============================================================================
# PostUpdate
#===============================================================================
[StateDef 1211920;
type: S; movetype: H; physics: N;
anim: 9999; ctrl: 0; velset: 0, 0;]
ignoreHitPause {

assertSpecial{flag: RunLast;}
notHitBy{attr: SCA,AA,AP,AT; time: -1;}

for i = cond(teamSide%2,2,1); (enemy,numPartner+1)*2 - (1-(teamSide%2)); 2 {
	let charID = player($i),ID;
	if player($i),moveType != H || player($i),ctrl || player($i),stateNo = 5150 {
		mapSet{map: "SokuComboLimit"; value: 0; redirectid: $charID;}
		mapSet{map: "SokuComboRate"; value: 1; redirectid: $charID;}
		mapSet{map: "SokuGetHitType"; value: 0; redirectid: $charID;}
	}
	if player($i),map(SokuComboLimit) >= 100 {
		getHitVarSet{fall.recover: 0; redirectid: $charID;}
		notHitBy{attr: SCA,AA,AP,AT; time: 1; slot: 7; redirectid: $charID;}
	} else if player($i),hitFall && player($i),canRecover {
		notHitBy{attr: SCA,AA,AP,AT; time: 1; slot: 7; redirectid: $charID;}
	}
	if player($i),authorName = "nns" && player($i),moveType = A && player($i),time < 10 {
		hitBy{value2: SCA,AA,AP,AT; time: 0; redirectid: $charID;}
		for h = player($i),numHelper; 1; -1 {
			let helpID = player($i),helperIndex($h),ID;
			if playerId($helpID),stateNo = 13000 {
				destroySelf{removeexplods: 1; recursive: 1; redirectid: $helpID}
			}
		}
	}
}

for i = 0; numPlayer - 1; 1 {
	let charID = playerIndex($i),ID;
	assertSpecial{flag: NoFallDefenceUp; flag2: NoKoVelocity; flag3: NoKoFall; redirectid: $charID;}
	if playerIndex($i),teamSide != root,teamSide && root,isAsserted(playerpush) && playerIndex($i),isAsserted(playerpush) && root,clsnOverlap(size, $charID, size) {
		let ff = sign(playerIndex($i),pos X+(playerIndex($i),distOffset X*playerIndex($i),facing)-(root,pos X+(root,distOffset X*root,facing)));
		let p1c = 0.0;
		let p2c = 0.0;
		if $ff = 0 {
			push{redirectid: $charID;}
			let ff = sign(playerIndex($i),pos X+(playerIndex($i),distOffset X*playerIndex($i),facing)-(root,pos X+(root,distOffset X*root,facing)));
		}
		if $ff = root,facing {
			let p1c = root,clsnVar(size, 0, front)*root,facing;
		} else {
			let p1c = root,clsnVar(size, 0, back)*root,facing;
		}
		if $ff != playerIndex($i),facing {
			let p2c = playerIndex($i),clsnVar(size, 0, front)*playerIndex($i),facing;
		} else {
			let p2c = playerIndex($i),clsnVar(size, 0, back)*playerIndex($i),facing;
		}
		let l = 0;
		while $l < 300 && abs(playerIndex($i),pos X + $p2c - root,pos X - $p1c) > 0.01
		{
			push{redirectid: $charID;}
			let l = $l+1;
		}
	}
}

if !root,spriteVar(height) {
	changeAnim{value: 0; redirectid: root,ID;}
}

}

[StateDef +1]

if !pauseTime {
	if map(GrazeTime) > 0 {
		notHitBy{attr: ,AP; time: 1; slot: 1;}
		map(GrazeTime) := map(GrazeTime)-1;
	}

if numExplod(10150) && anim != [150,152] {
	explod{id: 10151; anim: 10150; animelem: explodVar(10150,0,animelem);
		pos: (explodVar(10150,0,pos X)-pos X)*facing,explodVar(10150,0,pos Y)-pos Y;
		postype: P1;
		sprpriority: sprPriority+1;
		bindtime: 0;
		removetime: 13;
		trans: add;
		alpha: 256,256;
		interpolation.time: 13;
		interpolation.alpha: 0,256;
		scale: 1.5,1.5;
		supermovetime: 0;
		pausemovetime: 0;
		ignorehitpause: 1;
		ownpal: 1;
		shader: "trans_rights";
		shadertime: -1;}
	removeExplod{id: 10150;}
}

if (moveType = H && anim != 150 && anim != 152) || inCustomState {map(NoElectron) := 1;}

if !isHelper && !inCustomState {

if getHitVar(frame) {
	call ActionStart(0);
}

if !ctrl {
	if map(CanMotionCancel) && stateType != A && command = "holdup" {
		call ActionStart(1);
		changeState{value: 41; ctrl: 0; continue: 1;}
	}
} else {
	call ActionStart(0);
	if stateType != A {
		if p2Dist X < 0 {turn{}}
		if command = "SuperJump" {
			assertCommand{name: "SuperJump"; buffer.time: 0;}
			call ActionStart(1);
			changeState{value: 41; ctrl: 0; continue: 1;}
		} else if command = "holdup" {
			call ActionStart(1);
			changeState{value: 40+(command = "holdx"); ctrl: 0; continue: 1;}
		} else if command = "holddown" && stateType = S {
			changeState{value: 10; ctrl: 1; continue: 1;}
		} else if stateNo != 20 && (command = "left" || command = "right") {
			changeState{value: 20; ctrl: 1; continue: 1;}
		} else if stateType = C && command != "holddown" {
			changeState{value: 12; ctrl: 1; continue: 1;}
		}
	}
}

ignoreHitPause if command = "L" && inputTime(L) = 1 {
	if map(DoubleTapL) = [1,18] {
		map(DoubleTapL) := 0;
		assertCommand{name: "BB"; buffer.time: 10;}
	} else {map(DoubleTapL) := 1;}
} else if map(DoubleTapL) {
	map(DoubleTapL) := map(DoubleTapL)+1;
}

ignoreHitPause if command = "R" && inputTime(R) = 1 {
	if map(DoubleTapR) = [1,18] {
		map(DoubleTapR) := 0;
		assertCommand{name: "FF"; buffer.time: 10;}
	} else {map(DoubleTapR) := 1;}
} else if map(DoubleTapR) {
	map(DoubleTapR) := map(DoubleTapR)+1;
}

if stateType = A && (ctrl || map(CanMotionCancel)) {
	if command = "FF" {
		call ActionStart(4);
		changeState{value: cond(facing = 1,110,115); ctrl: 0; continue: 1;}
	} else if command = "BB" {
		call ActionStart(4);
		changeState{value: cond(facing = -1,110,115); ctrl: 0; continue: 1;}
	}
} else if stateType != A && command = "holdx" {
