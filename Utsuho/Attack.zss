}

if !moveContact {
	hitDef{attr: S,NP; hitflag: MAF; guardflag: MA; animtype: back; priority: 4,Hit; damage: 15,0; pausetime: 0,10; sparkno: -1; guard.sparkno: -1; sparkxy: 0,0; hitsound: -1; guardsound: -1; ground.type: High; ground.slidetime: 21; ground.hittime: 21; air.hittime: 21; guard.ctrltime: 21; airguard.ctrltime: 19; yaccel: 0.25; ground.velocity: -9,-4; guard.velocity: -6.5; air.velocity: -9,-4; airguard.velocity: -3,-6; ground.cornerpush.veloff: 0; air.cornerpush.veloff: 0; down.cornerpush.veloff: 0; guard.cornerpush.veloff: 0; airguard.cornerpush.veloff: 0; air.juggle: 0; p1sprpriority: 3; p1getp2facing: 0; fall: 1; fall.yvelocity: 0; fall.recover: 1; fall.recovertime: 50; fall.damage: 0; down.bounce: 1; id: 510; chainID: -1; nochainID: -1; hitonce: 1; guard.kill: 0; numhits: 1; stand.friction: 1; crouch.friction: 1;}
}

[StateDef 522;
type: A;
movetype: I;
physics: N;
anim: 522;
poweradd: 0;
ctrl: 0;
sprpriority: 3;]

ignoreHitPause {

for i = 0; numExplod(524) - 1; 1 {
	let etime = explodVar(524, $i, time);
	let escale = explodVar(524, $i, friction Z);
	modifyExplod{id: 524; index: $i; scale: $escale*(1.0+(0.05*$etime)),$escale*(0.9**$etime);}
}

if time {
	fVar(0) := fVar(0)+17.5;
}
let beamscale = fVar(0)/256;
let beamangle = deg(map(BeamAngle))-90;
let beamEndX = sin(map(BeamAngle))*fVar(0);
let beamEndY = cos(map(BeamAngle))*fVar(0);
let scaleFade = 0.85**(time+1);

angleDraw{value: $beamangle; scale: $beamscale,0.75*$scaleFade;}

notHitBy{value: ,AA,AT; time: -1;}

fVar(1) := fVar(1)-0.0625;
shaderSet{shader: "nuke_beam"; shaderparam.p0: $beamscale*2; shaderparam.p1: fVar(1); time: -1;}

overrideClsn{group: size; index: -1; rect: 0, 0, 0, 0;}

modifyExplod{id: 521; angle: randomRange(-18000, 18000)/100.0; scale: $scaleFade,$scaleFade;}
modifyExplod{id: 523; angle: randomRange(-18000, 18000)/100.0; pos: $beamEndX*facing,$beamEndY; scale: $scaleFade,$scaleFade;}

if time >= 30 {
	destroySelf{removeexplods: 1;}
}

}

[StateDef 525;
type: C;
movetype: A;
physics: N;
ctrl: 0;
velset: 0,0;
anim: 525;
sprpriority: 2;]

if animElem = 16 {
	stateTypeSet{movetype: I;}
} else if animElem = 8 {
	map(CanActionCancel) := 1;
	playSnd{value: S520,0; volumescale: 200;}
	helper{id: 520; stateno: 521; pos: 53,-80.5; postype: p1; facing: 1; ownpal: 1; inheritjuggle: 1; map.ZenithClashDNPH: 1; map.ZenithClashDNHH: 1; map.ZenithClashPoints: 10; map.BeamAngle: pi/1.5; map.bindposx: 53; map.bindposy: -80.5;}
} else if animElem = 13 {
	map(CanMotionCancel) := 1;
} else if !animTime {
	changeState{value: 11; ctrl: 1;}
}

[StateDef 725;
type: A;
movetype: A;
physics: N;
ctrl: 0;
anim: 725;
sprpriority: 2;]

if !time {
	sysfvar(35) := 0;
	velMul{x: .2; y: .2;}
}

if pos Y >= 0 && vel Y = 0 {
	changeState{value: 514; ctrl: 0;}
}

velAdd{y: sysfvar(35);}

if vel Y + pos Y >= 0 {
	posSet{y: 0;}
	velSet{y: 0;}
}

if animElem = 18 {
	stateTypeSet{movetype: I;}
} else if animElem = 8 {
	map(CanActionCancel) := 1;
	playSnd{value: S520,0; volumescale: 200;}
	helper{id: 520; stateno: 521; pos: 32.5,-21.5; postype: p1; facing: 1; ownpal: 1; inheritjuggle: 1; map.ZenithClashDNPH: 1; map.ZenithClashDNHH: 1; map.ZenithClashPoints: 10; map.BeamAngle: rad(45); map.bindposx: 32.5; map.bindposy: -21.5;}
} else if animElem = 13 {
	map(CanMotionCancel) := 1;
} else if animElem = 19 {
	sysfvar(35) := .25;
} else if !animTime {
	changeAnim{value: 44; elem: 6;}
	changeState{value: 50; ctrl: 1;}
}
