[StateDef 620;
type: A;
movetype: A;
physics: N;
ctrl: 0;
anim: 620+const(Mugensoku.Utsuho.BetterJ2A);
sprpriority: 1;]

if !time {
	sysfvar(35) := 0;
	if !const(Mugensoku.Utsuho.BetterJ2A) {
		velMul{x: .2; y: .2;}
	} else {
		velSet{x: min(abs(vel X), 5)*sign(vel X)}
	}
	map(Charge) := 1;
}
if const(Mugensoku.Utsuho.BetterJ2A) && animElemTime(5) < 0 {
	velMul{y: .9;}
}
if command != "holda" {
	map(Charge) := 0;
}

if moveContact = 1 {
	map(CanActionCancel) := 1;
	map(DoSokuCornerPush) := 0;
	map(SokuCornerPush) := 0;
	map(SokuGuardCornerPush) := -4.65*facing;
	map(SokuGuardCornerPushDecel) := 0.225;
	map(SokuAirCornerPush) := -6*facing;
}

if pos Y >= 0 && vel Y = 0 {
	if const(Mugensoku.Utsuho.BetterJ2A) {
		changeState{value: 621; ctrl: 0;}
	} else {
		changeState{value: 52; ctrl: 1;}
	}
}

if animTime {
	velAdd{y: sysFVar(35);}
} else {
	changeAnim{value: 41; elem: 13;}
	changeState{value: 50; ctrl: 1;}
}

if vel Y + pos Y >= 0 {
	posSet{y: 0;}
	velSet{y: 0;}
}

if animElem = 4 && map(Charge) {
	changeState{value: 625; ctrl: 0;}
