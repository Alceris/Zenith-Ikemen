[Function ActionStart(ActionLock)]
map(ActionLock) := $ActionLock;
map(CanActionCancel) := 0;
map(CanMotionCancel) := 0;
map(CanGuard) := 0;

[Function HitFactors(Proration, LimitGain, Friction, Effect, ComboModifiers)]
map(Proration) := $Proration;
map(LimitGain) := $LimitGain;
map(SokuHitFriction) := $Friction;
map(SokuHitEffect) := $Effect;
map(SokuComboModifiers) := $ComboModifiers; # 1 = Lift Attack, 2 = Smash Attack, 3 = Both

[Function SpendBorder(Cost, Cooldown, Power)]
guardPointsAdd{value: -$Cost;}
map(_iksys_guardPointsTimer) := max(map(_iksys_guardPointsTimer),$Cooldown);
powerAdd{value: $Power;}

[Function ChargeEffect(X, Y)]
playSnd{value: S3,3; volumescale: 200;}
explod{id: 100700; anim: 100700; pos: $X,$Y; postype: P1; sprpriority: 3; bindtime: 0; removetime: -2; scale: 1,1; supermovetime: -1; pausemovetime: -1; ownpal: 1; shader: "trans_rights"; shadertime: -1; palfx.time: -1; palfx.mul: 256,256,256; interpolation.time: 16; interpolation.palfx.mul: 0,0,256; ignorehitpause: 1;}
explod{id: 100700; anim: 100701; pos: $X,$Y; postype: P1; sprpriority: 3; bindtime: 0; removetime: -2; scale: 1,1; supermovetime: -1; pausemovetime: -1; ownpal: 1; shader: "trans_rights"; shadertime: -1; palfx.time: -1; palfx.mul: 256,256,256; interpolation.time: 11; interpolation.palfx.mul: 0,0,256; ignorehitpause: 1;}

[StateDef 200;
type: S;
movetype: A;
physics: N;
ctrl: 0;
anim: 200;
sprpriority: 1;]

if !time && prevStateNo != 101 {
	velSet{x: 0;}
}

if vel X > 0 {
	if animElemTime(3) > 0 {
		velAdd{x: ifElse(vel X < .375,-vel X,-.375);}
	} else if time {
		velAdd{x: ifElse(vel X < .25,-vel X,-.25);}
	}
}

if animElem = 2 {
	call HitFactors(0.9, 0, 1.5, 3, 0);
	map(SokuHitType) := 0;
	map(ZenithNoClash) := 1;
	playSnd{value: S2,1;}
	hitDef{attr: S, NA;
	damage: 75;
	hitonce: enemynear,name != "Dragon Tank";
	animtype: Heavy;
	guardflag: MA;
	hitflag: MAF;
	priority: 4, Hit;
	pausetime: 10, 10;
	sparkno: -1;
	sparkxy: -10, -88;
	hitsound: S0, 2;
	guardsound: S1, 0;
	ground.type: High;
	ground.slidetime: 24;
	ground.hittime: 24;
	ground.velocity: -12.5;
	guard.ctrltime: 21;
	guard.velocity: -6.5;
	airguard.velocity: -3,-6;
	airguard.ctrltime: 19;
	air.type: High;
	air.velocity: -3.75,-7.5;
	air.hittime: 12;
	air.fall: 1;
	fall.recover: 1;
	fall.recovertime: 55;
	yaccel: 0.25;
	stand.friction: 1;
	crouch.friction: 1;
	getpower: 120,80;
	ground.cornerpush.veloff: 0; air.cornerpush.veloff: 0; down.cornerpush.veloff: 0; guard.cornerpush.veloff: 0; airguard.cornerpush.veloff: 0;}

} else if animElem = 3 {
	velSet{x: 5;}
} else if animTime = 0 {
	changeState{value: 0; ctrl: 1;}
}

if moveContact = 1 {
	map(CanActionCancel) := 1;
	map(DoSokuCornerPush) := 0;
	map(SokuCornerPush) := -8.25*facing;
	map(SokuCornerPushDecel) := 1.125;
	map(SokuGuardCornerPush) := -4.65*facing;
	map(SokuGuardCornerPushDecel) := 0.225;
	map(SokuAirCornerPush) := -6*facing;
}

