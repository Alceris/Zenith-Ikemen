ignoreHitPause {

for i = 0; numExplod(524) - 1; 1 {
	let etime = explodVar(524, $i, time);
	let escale = explodVar(524, $i, friction Z);
	modifyExplod{id: 524; index: $i; scale: $escale*(1.0+(0.05*$etime)),$escale*(0.9**$etime);}
}

if time {
	fVar(0) := fVar(0)+17.5;
}
let beamscale = fVar(0)/256;
let beamangle = deg(map(BeamAngle))-90;
let beamEndX = sin(map(BeamAngle))*fVar(0);
let beamEndY = cos(map(BeamAngle))*fVar(0);
let scaleFade = 0.85**(time+1);

angleDraw{value: $beamangle; scale: $beamscale,0.75*$scaleFade;}

notHitBy{value: ,AA,AT; time: -1;}

fVar(1) := fVar(1)-0.0625;
shaderSet{shader: "nuke_beam"; shaderparam.p0: $beamscale*2; shaderparam.p1: fVar(1); time: -1;}

overrideClsn{group: size; index: -1; rect: 0, 0, 0, 0;}

modifyExplod{id: 521; angle: randomRange(-18000, 18000)/100.0; scale: $scaleFade,$scaleFade; sprpriority: sprPriority;}
modifyExplod{id: 523; angle: randomRange(-18000, 18000)/100.0; pos: $beamEndX*facing,$beamEndY; scale: $scaleFade,$scaleFade; sprpriority: sprPriority;}

if time >= 30 {
	destroySelf{removeexplods: 1;}
}

}

[StateDef 525;
type: C;
movetype: A;
physics: N;
ctrl: 0;
velset: 0,0;
anim: 525;
sprpriority: 1;]

if animElem = 16 {
	stateTypeSet{movetype: I;}
} else if animElem = 8 {
	map(CanActionCancel) := 1;
	playSnd{value: S520,0; volumescale: 200;}
	helper{id: 520; stateno: 521; pos: 53,-80.5; postype: p1; facing: 1; ownpal: 1; inheritjuggle: 1; map.ZenithClashDNPH: 1; map.ZenithClashDNHH: 1; map.ZenithClashPoints: 10; map.BeamAngle: pi/1.5; map.bindposx: 53; map.bindposy: -80.5; inheritchannels: 1;}
	call SpendBorder(200, 60, 50);
} else if animElem = 13 {
	map(CanMotionCancel) := 1;
} else if !animTime {
	changeState{value: 11; ctrl: 1;}
}

[StateDef 725;
type: A;
movetype: A;
physics: N;
ctrl: 0;
anim: 725;
sprpriority: 1;]

if !time {
	sysfvar(35) := 0;
	velMul{x: .2; y: .2;}
}

if pos Y >= 0 && vel Y = 0 {
	changeState{value: 514; ctrl: 0;}
}

velAdd{y: sysfvar(35);}

if vel Y + pos Y >= 0 {
	posSet{y: 0;}
	velSet{y: 0;}
}

if animElem = 18 {
	stateTypeSet{movetype: I;}
} else if animElem = 8 {
	map(CanActionCancel) := 1;
	playSnd{value: S520,0; volumescale: 200;}
	helper{id: 520; stateno: 521; pos: 32.5,-21.5; postype: p1; facing: 1; ownpal: 1; inheritjuggle: 1; map.ZenithClashDNPH: 1; map.ZenithClashDNHH: 1; map.ZenithClashPoints: 10; map.BeamAngle: rad(45); map.bindposx: 32.5; map.bindposy: -21.5; inheritchannels: 1;}
	call SpendBorder(200, 60, 50);
} else if animElem = 13 {
	map(CanMotionCancel) := 1;
} else if animElem = 19 {
	sysfvar(35) := .25;
} else if !animTime {
	changeAnim{value: 44; elem: 6;}
	changeState{value: 50; ctrl: 1;}
}
