	playSnd{value: S1200,2; volumescale: 200; channel: 12;}
	let xangle = randomRange(0,35999)/100.0;
	let yangle = randomRange(0,35999)/100.0;
	explod{anim: 1208; ID: 1208; pos: 0,0; postype: p1; bindtime: -1; removetime: -2; pausemovetime: 0; supermovetime: 0; scale: const(size.xscale),const(size.yscale); friction: 0.1,0.1,0; xangle: $xangle; yangle: $yangle; interpolation.time: 31; interpolation.angle: 0,$xangle-93,$yangle+186; sprpriority: sprPriority; syncid: ID; synclayer: 1; syncparams: 0; shadow: 0,0,0; reflection: 1; shader: "trans_rights"; shadertime: -1; ownpal: 1; removeongethit: 0; ignorehitpause: 1;}
	let xangle = randomRange(0,35999)/100.0;
	let yangle = randomRange(0,35999)/100.0;
	explod{anim: 1209; ID: 1209; pos: 0,0; postype: p1; bindtime: -1; removetime: -2; pausemovetime: 0; supermovetime: 0; scale: const(size.xscale),const(size.yscale); friction: 0.1,0.1,0; xangle: $xangle; yangle: $yangle; interpolation.time: 31; interpolation.angle: 0,$xangle+93,$yangle-186; sprpriority: sprPriority; syncid: ID; synclayer: 1; syncparams: 0; shadow: 0,0,0; reflection: 1; shader: "trans_rights"; shadertime: -1; ownpal: 1; removeongethit: 0; ignorehitpause: 1;}
}

fVar(0) := fVar(0)+0.375;

velSet{x: fVar(0)*cos(map(Angle)); y: fVar(0)*sin(map(Angle));}

ignoreHitPause {

if moveHitVar(frame) && (!map(ZenithClashNonCompat) || hasHit(enemyNear,ID)) {
	if moveHit {
		playSnd{value: S0,2; volumescale: 100; channel: 2;}
	}
	if moveGuarded {
		playSnd{value: S1,0; volumescale: 100; channel: 2;}
	}
}

notHitBy{value: SCA,AA,AP,AT; time: -1;}

overrideClsn{group: size; index: -1; rect: 0, 0, 0, 0;}

if map(ZenithClashesHiPrio) > 0 || map(GrazedTime) > 5 {
	map(ZenithClashPoints) := 0;
} else if map(ZenithClashesEqPrio) > 0 {
	mapAdd{map: "ZenithClashPoints"; value: -map(ZenithClashesEqPrio);}
}

if moveContact && (!map(ZenithClashNonCompat) || hasHit(enemyNear,ID)) || map(GotGrazed) || !map(ZenithClashPoints) {
	changeState{value: 1209;}
}

if numExplod(1208) {
	let escale = explodVar(1208, 0, friction X);
	let fy = explodVar(1208, 0, friction Y)*0.94;
	modifyExplod{id: 1208; scale: 1+$escale,1+$escale; friction: $escale+$fy,$fy,0;}
}

if numExplod(1209) {
	let escale = explodVar(1209, 0, friction X);
	let fy = explodVar(1209, 0, friction Y)*0.96;
	modifyExplod{id: 1209; scale: 1+$escale,1+$escale; friction: $escale+$fy,$fy,0;}
}

hitDef{attr: S,SP; hitflag: MAF; guardflag: MA; animtype: Medium; priority: floor(map(BasePriority))-1,Hit; damage: 20,5; guardpoints: 50; getpower: 20,20; pausetime: 0,0; guard.pausetime: 0,0; sparkno: -1; guard.sparkno: -1; sparkxy: 0,0; hitsound: -1; guardsound: -1; ground.type: High; ground.slidetime: 17; ground.hittime: 17; air.hittime: 20; guard.ctrltime: 15; yaccel: 0.25; ground.velocity: -7.5; guard.velocity: -5; air.velocity: -3,-6; airguard.velocity: -3,-6; airguard.ctrltime: 19; ground.cornerpush.veloff: 0; air.cornerpush.veloff: 0; down.cornerpush.veloff: 0; guard.cornerpush.veloff: 0; airguard.cornerpush.veloff: 0; air.juggle: 0; p1sprpriority: 3; p1getp2facing: 0; air.fall: 1; fall.xvelocity: -1.5; fall.recover: 1; fall.recovertime: 25; fall.damage: 0; down.bounce: 1; id: 1200; chainID: -1; nochainID: -1; hitonce: enemynear,name != "Dragon Tank"; guard.kill: 0; numhits: 1; stand.friction: 1; crouch.friction: 1;}

}

if time > 71 {
	destroySelf{}
}

[StateDef 1209;
type: A;
movetype: A;
physics: N;
poweradd: 0;
anim: 1210;
velset: 0,0;
ctrl: 0;
sprpriority: 3;]

if !time {
	playSnd{value: S500,1; volumescale: 200; channel: 6;}
} else if !animTime {
	destroySelf{removeexplods: 1;}
}

ignoreHitPause {

if numExplod(1208) {
	let escale = explodVar(1208, 0, friction X);
	let fy = explodVar(1208, 0, friction Y)*0.94;
	modifyExplod{id: 1208; scale: 1+$escale,1+$escale; friction: $escale+$fy,$fy,0;}
}

if numExplod(1209) {
	let escale = explodVar(1209, 0, friction X);
	let fy = explodVar(1209, 0, friction Y)*0.96;
	modifyExplod{id: 1209; scale: 1+$escale,1+$escale; friction: $escale+$fy,$fy,0;}
}

notHitBy{value: SCA,AA,AP,AT; time: -1;}

overrideClsn{group: size; index: -1; rect: 0, 0, 0, 0;}

angleDraw{value: 0; scale: 0.98**time,0.98**time;}

}
