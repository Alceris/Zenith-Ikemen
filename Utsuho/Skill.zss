[StateDef 1304;
type: S;
movetype: A;
physics: N;
velset: map(VelX),map(VelY);
poweradd: 0;
ctrl: 0;
sprpriority: 2;]

if root,moveType = H && !root,getHitVar(guarded) {
	destroySelf{}
}

if !time {
	call HitFactors(0.93, 5, 0.75, 2, 0);
	let angle = atan2(vel Y,vel X);
	fVar(0) := 0.25*cos($angle);
	fVar(1) := 0.25*sin($angle);
	shaderSet{shader: "trans_rights"; time: -1;}
}

velAdd{x: fVar(0); y: fVar(1);}

ignoreHitPause {

notHitBy{value: SCA,AA,AP,AT; time: -1;}

overrideClsn{group: size; index: -1; rect: 0, 0, 0, 0;}

if map(ZenithClashesHiPrio) > 0 {
	map(ZenithClashPoints) := 0;
} else if map(ZenithClashesEqPrio) > 0 {
	mapAdd{map: "ZenithClashPoints"; value: -map(ZenithClashesEqPrio);}
}

if (moveContact && (!map(ZenithClashNonCompat) || !playerId(moveHitVar(playerid)),isHelper)) || map(GotGrazed) || map(ZenithClashPoints) <= 0 {
