[Function ActionStart(ActionLock)]
map(ActionLock) := $ActionLock;
map(CanActionCancel) := 0;
map(CanMotionCancel) := 0;
map(CanGuard) := 0;

[Function SpendBorder(Cost, Cooldown, Power)]
guardPointsAdd{value: -$Cost;}
map(_iksys_guardPointsTimer) := max(map(_iksys_guardPointsTimer),$Cooldown);
powerAdd{value: $Power;}

[Function HitFactors(Proration, LimitGain, Friction, Effect, ComboModifiers)]
map(Proration) := $Proration;
map(LimitGain) := $LimitGain;
map(SokuHitFriction) := $Friction;
map(SokuHitEffect) := $Effect;
map(SokuComboModifiers) := $ComboModifiers; # 1 = Lift Attack, 2 = Smash Attack, 3 = Both

[StateDef 1000;
type: S;
movetype: A;
physics: N;
ctrl: 0;
sprpriority: 1;]

if pos Y < 0 {
	stateTypeSet{statetype: A;}
}

if !time {
	sysfvar(35) := 0;
	velSet{x: 0; y: 0;}
}

if stateType = A && pos Y >= 0 && vel Y = 0 {
	changeState{value: 514; ctrl: 0;}
}

velAdd{y: sysfvar(35);}

if vel Y + pos Y >= 0 {
	posSet{y: 0;}
	velSet{y: 0;}
}

if animElem = 8 {
	playSnd{value: S1000,0; volumescale: 200;}
	helper{id: 1000; stateno: 1001; pos: 68.5,cond(anim = 1010,-73,-68); postype: p1; facing: 1; ownpal: 1; map.bindposx: 68.5; map.bindposy: cond(anim = 1010,-73,-68); inheritchannels: 1;}
	call SpendBorder(200, 120, 50);
} else if animElem = 9 {
	map(CanActionCancel) := 1;
} else if animElem = 16 {
	stateTypeSet{movetype: I;}
	map(CanMotionCancel) := 1;
} else if animElem = 23 && statetype = A {
	sysfvar(35) := .25;
} else if !animTime {
	if stateType = A {
		changeAnim{value: 44; elem: 6;}
		changeState{value: 50; ctrl: 1;}
	} else {
		changeState{value: 0; ctrl: 1;}
	}
}

[StateDef 1001;
type: A;
movetype: I;
physics: N;
anim: 1002;
poweradd: 0;
ctrl: 0;
sprpriority: 3;]

ignoreHitPause {

if !time {
	shaderSet{shader: "trans_rights"; time: -1;}
	fVar(0) := -72;
	fVar(1) := 1;
	explod{anim: 1003; ID: 1003; pos: 0,0; postype: p1; facing: 1; bindtime: -1; removetime: -1; pausemovetime: 0; palfx.time: -1; sprpriority: 3; shadow: 0,0,0; ownpal: 1; ignorehitpause: 1;}
	explod{anim: 1004; ID: 1004; pos: 0,0; postype: p1; facing: 1; bindtime: -1; removetime: -1; pausemovetime: 0; palfx.time: -1; sprpriority: 3; shadow: 0,0,0; shader: "trans_rights"; shadertime: -1; ownpal: 1; ignorehitpause: 1;}
} else {
	if time = 26 || (root,moveType = H && !root,getHitVar(guarded)) {
		changeState{value: 1002;}
	}
	fVar(0) := fVar(0)*0.9;
}

posSet{x: parent,pos X+(map(bindposx)*facing); y: parent,pos Y+map(bindposy);}

let beamDir = rad(fVar(0));
let beamEndY = pos Y/sin($beamDir);
let beamEndX = cos($beamDir)*$beamEndY;

if time%3 = 0 {
	helper{id: 1001; stateno: 1003; pos: pos X+cameraPos X+($beamEndX*facing),0; postype: none; facing: facing; ownpal: 1; inheritjuggle: 1; map.ZenithClashDNPH: 1; map.ZenithClashDNHH: 1; map.ZenithClashPoints: 1; inheritchannels: 1; redirectid: root,ID;}
}

for i = 0; 1; 1 {
	let escale = 1.0+randomrange(0,100)*0.01;
	let eangle = randomRange(-18000, 18000)/100.0;
	let edirec = rad($eangle);
	let espeed = randomRange(500,1500)/100.0;
	explod{anim: 524; ID: 524; pos: $beamEndX,-pos Y; postype: p1; facing: 1; vfacing: 1; bindtime: 0; vel: $espeed*sin($edirec),$espeed*cos($edirec); friction: 0.9,0.9,$escale; angle: $eangle-90; removetime: 31; pausemovetime: 0; scale: const(size.xscale),const(size.yscale); palfx.time: -1; palfx.mul: 256,256,256; trans: add; alpha: 256,256; interpolation.time: 31; interpolation.alpha: 0,256; interpolation.palfx.mul: 256,0,0; sprpriority: 5; ontop: 0; shadow: 0,0,0; reflection: 1; shader: "trans_rights"; shadertime: -1; ownpal: 1; removeongethit: 0; ignorehitpause: 1;}
}
explod{anim: 1005; ID: 1005; pos: $beamEndX,-pos Y; postype: p1; facing: 1; vfacing: 1; bindtime: 0; removetime: 31; pausemovetime: 0; scale: 1.025,1.025; palfx.time: -1; palfx.mul: 256,256,256; trans: add; alpha: 256,256; interpolation.time: 32; interpolation.alpha: 0,256; interpolation.scale: 1.8,1.8; interpolation.palfx.mul: 256,0,0; sprpriority: 3; ontop: 0; shadow: 0,0,0; shader: "trans_rights"; shadertime: -1; ownpal: 1; removeongethit: 0; ignorehitpause: 1;}

angleDraw{value: randomRange(0,35999)/100.0; scale: 1,1;}

notHitBy{value: SCA,AA,AP,AT; time: -1;}

fVar(2) := fVar(2)-0.078125;

overrideClsn{group: size; index: -1; rect: 0, 0, 0, 0;}

modifyExplod{id: 1003; angle: fVar(0); scale: $beamEndY/256,0.05; shader: "nuke_beam"; shadertime: -1; shaderparam.p0: $beamEndY*2; shaderparam.p1: fVar(2);}

modifyExplod{id: 1004; angle: randomRange(0,35999)/100.0; scale: 1,1; pos: $beamEndX*facing,-pos Y;}

for i = 0; numExplod(524) - 1; 1 {
	let etime = explodVar(524, $i, time);
	let escale = explodVar(524, $i, friction Z);
	modifyExplod{id: 524; index: $i; scale: $escale*(1.0+(0.05*$etime)),$escale*(0.9**$etime);}
}

}

[StateDef 1002;
type: A;
movetype: I;
physics: N;
poweradd: 0;
ctrl: 0;
sprpriority: 3;]

ignoreHitPause {

fVar(0) := fVar(0)*0.9;

let beamDir = rad(fVar(0));
let beamEndY = pos Y/sin($beamDir);
let beamEndX = cos($beamDir)*$beamEndY;

fVar(1) := fVar(1)*0.85;

angleDraw{value: randomRange(0,35999)/100.0; scale: fVar(1),fVar(1);}

notHitBy{value: SCA,AA,AP,AT; time: -1;}

fVar(2) := fVar(2)-0.078125;

overrideClsn{group: size; index: -1; rect: 0, 0, 0, 0;}

if time >= 27 && !numExplod(524) {
	destroySelf{removeexplods: 1;}
}

modifyExplod{id: 1003; angle: fVar(0); scale: $beamEndY/256,0.05*fVar(1); shader: "nuke_beam"; shadertime: -1; shaderparam.p0: $beamEndY*2; shaderparam.p1: fVar(2);}

modifyExplod{id: 1004; angle: randomRange(0,35999)/100.0; scale: fVar(1),fVar(1); pos: $beamEndX,-pos Y;}

for i = 0; numExplod(524) - 1; 1 {
	let etime = explodVar(524, $i, time);
	let escale = explodVar(524, $i, friction Z);
	modifyExplod{id: 524; index: $i; scale: $escale*(1.0+(0.05*$etime)),$escale*(0.9**$etime);}
}

}

[StateDef 1003;
type: A;
movetype: I;
physics: N;
ctrl: 0;
anim: 1009;
sprpriority: 2;]

if moveHitVar(frame) && (!map(ZenithClashNonCompat) || hasHit(enemyNear,ID)) {
	if moveHit {
		playSnd{value: S0,2; volumescale: 100; channel: 2;}
	}
	if moveGuarded {
		playSnd{value: S1,0; volumescale: 100; channel: 2;}
	}
}

if map(ZenithClashesHiPrio) > 0 {
	map(ZenithClashPoints) := 0;
} else if map(ZenithClashesEqPrio) > 0 {
	mapAdd{map: "ZenithClashPoints"; value: -map(ZenithClashesEqPrio);}
}

if moveContact && moveHitVar(frame) && (!map(ZenithClashNonCompat) || HasHit(enemynear,ID)) {
	mapAdd{map: "ZenithClashPoints"; value: -1;}
}

if (root,moveType = H && !root,getHitVar(guarded)) {
	if !numExplod(1006) {
		destroySelf{}
	} else {
		changeAnim{value: 1009; elem: 21;}
	}
}
if animElemTime(21) >= 0 && !numExplod(1006) {
	destroySelf{}
} else if animElem = 2 {
	shaderSet{shader: "trans_rights"; time: -1;}
	stateTypeSet{movetype: A;}
	call HitFactors(0.95, 10, 0, 4, 2);
	map(SokuHitType) := 1;
	explod{id: 1007; anim: 1007; pos: 0,0; postype: P1; sprpriority: 0; bindtime: 0; facing: 1; removetime: -2; ownpal: 1; xangle: -80; shader: "trans_rights"; shadertime: -1;}
	let eangle = randomRange(0,35999)/100.0;
	for i = 0; 7; 1 {
		let eangle = $eangle+45;
		let espeed = randomRange(950,1450)/100.0;
		explod{anim: 1006; ID: 1006; pos: 0,0; postype: p1; facing: 1; vfacing: 1; bindtime: 0; vel: $espeed*sin($eangle),$espeed*cos($eangle)*0.2; accel: -0.25*sin($eangle),-0.05*cos($eangle); friction: 1,1,randomRange(-500,500)/100.0; angle: randomRange(0,35999)/100.0; removetime: -2; palfx.time: -1; palfx.mul: 256,256,256; interpolation.time: 37; interpolation.palfx.mul: 256,0,0; sprpriority: 5; ontop: 0; shadow: 0,0,0; reflection: 1; shader: "trans_rights"; shadertime: -1; ownpal: 1; removeongethit: 0; ignorehitpause: 1;}
	}
}

for i = 0; numExplod(1006) - 1; 1 {
	let etime = explodVar(1006, $i, time)+1.0;
	let eanglevel = (explodVar(1006, $i, friction Z)*$etime)*(0.98**$etime);
	modifyExplod{id: 1006; index: $i; angle: $eanglevel;}
}

if !moveContact && animElemTime(2) >= 0 {
	hitDef{attr: S, SP;
	damage: 40,10;
	hitonce: enemynear,name != "Dragon Tank";
	animtype: Up;
	guardflag: MA;
	hitflag: MAF;
	priority: map(BasePriority), Hit;
	pausetime: 0, 3;
	guard.pausetime: 0,0;
	sparkno: -1;
	sparkxy: 0, -70;
	hitsound: -1;
	guardsound: -1;
	ground.type: Low;
	ground.slidetime: 34;
	ground.hittime: 34;
	ground.velocity: -8.75,-3.75;
	guard.ctrltime: 27;
	airguard.ctrltime: 19;
	air.type: Low;
	air.velocity: -8.75,-3.75;
	air.hittime: 0;
	guard.velocity: -7.25;
	airguard.velocity: -3,-6;
	fall: 1;
	fall.recover: 1;
	fall.xvelocity: -4.375;
	fall.recovertime: 63;
	yaccel: 0.4;
	guardpoints: 75;
	stand.friction: 1;
	crouch.friction: 1;
	getpower: 25,25;
	ground.cornerpush.veloff: 0; air.cornerpush.veloff: 0; down.cornerpush.veloff: 0; guard.cornerpush.veloff: 0; airguard.cornerpush.veloff: 0;}
}

