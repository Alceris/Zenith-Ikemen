		let projvely = root,projVar(-1, $p, vel Y);
		modifyProjectile{index: $p; offset: $projvelx,$projvely; redirectid: $rootID;}
		if root,projVar(-1, $p, projhits) > 0 && playerIndex($i),teamSide != root,projVar(-1, $p, teamside) && root,projClsnOverlap($p, $charID, clsn2) {
