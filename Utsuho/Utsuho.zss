[Function ActionStart(ActionLock)]
map(ActionLock) := $ActionLock;
map(CanActionCancel) := 0;
map(CanMotionCancel) := 0;
map(CanGuard) := 0;

#-------------------------------------------------------------------------------
# Walk
[StateDef 20; type: S; physics: S; sprpriority: 0;]

if p2Dist X < 0 {turn{}}

if inputTime(L) > 0 {
	velSet{x: const(velocity.walk.back.x)*facing}
} else if inputTime(R) > 0 {
	velSet{x: const(velocity.walk.fwd.x)*facing}
}
if vel x > 0 {
	if cond(anim = 5, animTime = 0, anim != 20) {
		changeAnim{value: 20}
	}
} else if vel x < 0 {
	if cond(anim = 5, animTime = 0, anim != 21) {
		changeAnim{value: 21}
	}
}

[StateDef 41; type: S; movetype: A; physics: N; anim: 40; ctrl: 0;]

attackDist{value: 0, 0;}
notHitBy{attr: ,AP,AT; time: 1; slot: 0;}

if !time {
	call ActionStart(1);
	if prevStateNo != 100 {
		velSet{x: 0;}
	}
	sysVar(1) := 0;
	if (command = "holdright" && command != "holdleft" && facing = 1) || (command = "holdleft" && command != "holdright" && facing = -1) {
		sysVar(1) := 1;
	} else if prevStateNo != 100 && ((command = "holdright" && command != "holdleft" && facing = -1) || (command = "holdleft" && command != "holdright" && facing = 1)) {
		sysVar(1) := 2;
	}
}

if !animTime {
	explod{
	id: 10041;
	anim: 10041;
	pos: 0,0;
	postype: P1;
	sprpriority: 3;
	bindtime: 0;
	facing: 1;
	removetime: -2;
	supermovetime: -1;
	pausemovetime: -1;
	trans: add;
	ownpal: 1;
	scale: 1,1;
	interpolation.time: 10;
	interpolation.scale: 2,2;
	shader: "trans_rights";
	shadertime: -1;
	}
	explod{
	id: 10042;
	anim: 10042;
	pos: 0,0;
	postype: P1;
	sprpriority: 3;
	bindtime: 0;
	facing: 1;
	removetime: 13;
	supermovetime: -1;
	pausemovetime: -1;
	trans: add;
	alpha: 256,256;
	ownpal: 1;
	xangle: -80;
	palfx.time: -1;
	palfx.mul: 256,256,256;
	scale: 0.35,0.35;
	interpolation.time: 13;
	interpolation.scale: 1.5,1.5;
	interpolation.alpha: 0,256;
	interpolation.palfx.mul: 0,0,256;
	shader: "trans_rights";
	shadertime: -1;
	}
	sysFVar(35) := ifelse(sysvar(1),.25,.2);
	playSnd{value: S100,1; volumescale: 100; channel: -1;}
	
	if prevStateNo = 100 {
		velSet{x: ifelse(sysvar(1) = 1,const(velocity.runjump.fwd.x),const(velocity.walk.fwd.x)); y: ifelse(sysvar(1),const(velocity.runjump.y),const(velocity.runjump.up.y))}
	} else {
		velSet{x: ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.runjump.fwd.x), const(velocity.runjump.back.x))); y: ifelse(sysvar(1),const(velocity.runjump.y),const(velocity.runjump.up.y))}
	}
	changeState{value: 49; anim: 41+sysVar(1); ctrl: 0;}
}

[StateDef 49; type: A; movetype: A; physics: N;]

if time = 1 {
	map(CanActionCancel) := 1;
}

if vel Y = 0 && pos Y >= 0 {
	changeState{value: 52; ctrl: 1;}
}

if vel Y < 0 {
	map(GrazeTime) := 2;
}

velAdd{y: sysFVar(35);}

if pos Y + vel Y >= 0 {
	posSet{y: 0;}
	velSet{y: 0;}
}

if animElem = 3 {
	ctrlSet{value: 1;}
}
if animElemTime(5) < 0 {
	notHitBy{attr: ,AP; time: 1; slot: 1;}
	assertSpecial{flag: NoAirGuard;}
	attackDist{value: 0, 0;}
} else {
	stateTypeSet{movetype: I;}
}

[StateDef 100;
type: S;
movetype: I;
physics: N;
velset: 0,0;
anim: 100;
poweradd: 0;
ctrl: 0;
sprpriority: 0;]

if animElemTime(3) >= 0 && animElemTime(3)%6 = 0 {
	explod{
	id: 10102;
	anim: 10102;
	pos: randomRange(-1500,3000)/100.0,randomRange(0,-10000)/100.0;
	postype: P1;
	sprpriority: 3;
	bindtime: 0;
	removetime: 14;
	supermovetime: -1;
	pausemovetime: -1;
	vel: -5,0;
	trans: add;
	alpha: 256,256;
	palfx.time: -1;
	palfx.mul: 256,256,256;
	scale: const(size.xscale),const(size.yscale);
	interpolation.time: 14;
	interpolation.palfx.mul: 0,0,256;
	interpolation.alpha: 0,256;
	ownpal: 1;
	shader: "trans_rights";
	shadertime: -1;
	}
}

if animElemTime(3) >= 0 && command = "holdup" {
	changeState{value: 41; ctrl: 0;}
}

if animElem = 3 {
	explod{
	id: 10100;
	anim: 10100;
	pos: 0,-40.5;
	postype: P1;
	sprpriority: 3;
	bindtime: 0;
	removetime: -2;
	supermovetime: -1;
	pausemovetime: -1;
	trans: add;
	ownpal: 1;
	shader: "trans_rights";
	shadertime: -1;
	}
	explod{
	id: 10101;
	anim: 10101;
	pos: 40,-55;
	postype: P1;
	sprpriority: 3;
	bindtime: 0;
	removetime: 10;
	supermovetime: -1;
	pausemovetime: -1;
	trans: add;
	alpha: 256,256;
	palfx.time: -1;
	palfx.mul: 256,256,256;
	scale: 0.6*const(size.xscale),0.6*const(size.yscale);
	interpolation.time: 10;
	interpolation.scale: 2.35*const(size.xscale),2.35*const(size.yscale);
	interpolation.palfx.mul: 0,0,256;
	interpolation.alpha: 0,256;
	ownpal: 1;
	shader: "trans_rights";
	shadertime: -1;
	}
	velSet{x: const(velocity.run.fwd.x);}
	playSnd{value: S100,0;}
}

if vel X > 6 {
	velSet{x: max(vel X - 0.25, 6.0);}
}

if time >= 30 && (command != "holdfwd" || (!const(Mugensoku.UnlimitedDash) && time >= 55) || (const(Mugensoku.UnlimitedDash) && p2Dist X < -20)) {
	changeState{value: 101; ctrl: 0;}
}

notHitBy{value: ,AP; time: 1;}

[StateDef 101;
type: S;
movetype: I;
physics: N;
anim: 101;
poweradd: 0;
ctrl: 0;
sprpriority: 0;]

if !time {
	call ActionStart(10);
	map(CanGuard) := 1;
}

notHitBy{value: ,AP; time: 1;}

if vel X {
	velSet{x: max(vel X - 0.25, 0);}
}
if animElem = 2 {
	map(CanActionCancel) := 1;
} else if animTime = 0 {
	changeState{value: 0; ctrl: 1;}
}

[StateDef 105;
type: S;
movetype: I;
physics: N;
velset: 0,0;
anim: 105;
poweradd: 0;
ctrl: 0;
sprpriority: 0;]

if stateType = A {
	velAdd{y: .125;}
}

if animElemTime(3) >= 0 && animElemTime(3)%6 = 0 {
	explod{
	id: 10102;
	anim: 10102;
	pos: randomRange(-3000,1500)/100.0,randomRange(0,-10000)/100.0;
	postype: P1;
	sprpriority: 3;
	bindtime: 0;
	removetime: 14;
	supermovetime: -1;
	pausemovetime: -1;
	vel: 5,0;
	facing: -1;
	trans: add;
	alpha: 256,256;
	palfx.time: -1;
	palfx.mul: 256,256,256;
	scale: const(size.xscale),const(size.yscale);
	interpolation.time: 14;
	interpolation.palfx.mul: 0,0,256;
	interpolation.alpha: 0,256;
	ownpal: 1;
	shader: "trans_rights";
	shadertime: -1;
	}
}

if animElem = 3 {
	explod{
	id: 10100;
	anim: 10100;
	pos: 0,-40.5;
	postype: P1;
	sprpriority: 3;
	bindtime: 0;
	facing: -1;
	removetime: -2;
	supermovetime: -1;
	pausemovetime: -1;
	trans: add;
	ownpal: 1;
	shader: "trans_rights";
	shadertime: -1;
	}
	explod{
	id: 10101;
	anim: 10101;
	pos: 0,-40.5;
	postype: P1;
	sprpriority: 3;
	bindtime: 0;
	removetime: 10;
	supermovetime: -1;
	pausemovetime: -1;
	trans: add;
	facing: -1;
	alpha: 256,256;
	palfx.time: -1;
	palfx.mul: 256,256,256;
	scale: 0.6*const(size.xscale),0.6*const(size.yscale);
	interpolation.time: 10;
	interpolation.scale: 2.35*const(size.xscale),2.35*const(size.yscale);
	interpolation.palfx.mul: 0,0,256;
	interpolation.alpha: 0,256;
	ownpal: 1;
	shader: "trans_rights";
	shadertime: -1;
	}
	velSet{x: const(velocity.run.back.x); y: const(velocity.run.back.y);}
	playSnd{value: S100,0;}
	stateTypeSet{statetype: A;}
}

if vel X < -6 {
	velSet{x: min(vel X + 0.25, -6.0);}
}

if stateType = A {
	if pos Y >= 0 && vel Y >= 0 {
		changeState{value: 106; ctrl: 0;}
	} else if pos Y + vel Y >= 0 {
		posSet{y: 0;}
		velSet{y: 0;}
	}
}

if time <= 21 {
	notHitBy{value: ,AA,AP,AT; time: 1;}
} else {
	notHitBy{value: ,AP; time: 1;}
}

[StateDef 106;
type: S;
movetype: I;
physics: N;
anim: 106;
poweradd: 0;
ctrl: 0;
sprpriority: 0;]

if !time {
	velSet{y: 0;}
	posSet{y: 0;}
}

if vel X < 0 {
	velSet{x: min(vel X+1, 0);}
}

if !animTime {
	changeState{value: 0; ctrl: 1;}
}

[StateDef 110;
type: A;
movetype: I;
physics: N;
velset: 0,0;
anim: 110;
poweradd: 0;
ctrl: 0;
sprpriority: 0;]

if !time {sysFVar(35) := 0;}

if vel Y = 0 && pos Y >= 0 {
	changeState{value: 52; ctrl: 1;}
}

velAdd{y: sysFVar(35);}

if pos Y + vel Y >= 0 {
	posSet{y: 0;}
	velSet{y: 0;}
}

if animElem = 6 {
	map(CanActionCancel) := 1;
	map(CanMotionCancel) := 1;
	explod{
	id: 10100;
	anim: 10100;
	pos: 0,-57;
	postype: P1;
	sprpriority: 3;
	bindtime: 0;
	removetime: -2;
	supermovetime: -1;
	pausemovetime: -1;
	trans: add;
	ownpal: 1;
	shader: "trans_rights";
	shadertime: -1;
	}
	explod{
	id: 10101;
	anim: 10101;
	pos: 38.5,-57;
	postype: P1;
	sprpriority: 3;
	bindtime: 0;
	removetime: 10;
	supermovetime: -1;
	pausemovetime: -1;
	trans: add;
	alpha: 256,256;
	palfx.time: -1;
	palfx.mul: 256,256,256;
	scale: 0.6*const(size.xscale),0.6*const(size.yscale);
	interpolation.time: 10;
	interpolation.scale: 2.35*const(size.xscale),2.35*const(size.yscale);
	interpolation.palfx.mul: 0,0,256;
	interpolation.alpha: 0,256;
	ownpal: 1;
	shader: "trans_rights";
	shadertime: -1;
	}
	velSet{x: const(velocity.run.fwd.x); y: -3;}
	sysFVar(35) := 0.25;
	playSnd{value: S100,0;}
} else if animElem = 10 {
	ctrlSet{value: 1;}
} else if animElem = 12 && p2Dist X < 0 {
	turn{}
}

if animElemTime(14) < 0 {
	if animElemTime(6) >= 0 && animElemTime(6)%6 = 1 {
		explod{
		id: 10102;
		anim: 10102;
		pos: randomRange(-1500,1500)/100.0,randomRange(0,-10000)/100.0;
		postype: P1;
		sprpriority: 3;
		bindtime: 0;
		removetime: 14;
		supermovetime: -1;
		pausemovetime: -1;
		vel: -5,0;
		trans: add;
		alpha: 256,256;
		palfx.time: -1;
		palfx.mul: 256,256,256;
		scale: const(size.xscale),const(size.yscale);
		interpolation.time: 14;
		interpolation.palfx.mul: 0,0,256;
		interpolation.alpha: 0,256;
		ownpal: 1;
		shader: "trans_rights";
		shadertime: -1;
		}
	}
	notHitBy{value: ,AP; time: 1;}
	if abs(vel X) > 6 {
		velSet{x: max(abs(vel X) - 0.25, 6.0)*sign(vel X);}
	}
}

[StateDef 115;
type: A;
movetype: I;
physics: N;
velset: 0,0;
anim: 115;
poweradd: 0;
ctrl: 0;
sprpriority: 0;]

if !time {sysFVar(35) := 0;}

if vel Y = 0 && pos Y >= 0 {
	changeState{value: 52; ctrl: 1;}
}

velAdd{y: sysFVar(35);}

if pos Y + vel Y >= 0 {
	posSet{y: 0;}
	velSet{y: 0;}
}

if animElem = 5 {
	explod{
	id: 10100;
	anim: 10100;
	pos: 1,-58.5;
	postype: P1;
	sprpriority: 3;
	facing: -1;
	bindtime: 0;
	removetime: -2;
	supermovetime: -1;
	pausemovetime: -1;
	trans: add;
	ownpal: 1;
	shader: "trans_rights";
	shadertime: -1;
	}
	explod{
	id: 10101;
	anim: 10101;
	pos: 1,-58.5;
	facing: -1;
	postype: P1;
	sprpriority: 3;
	bindtime: 0;
	removetime: 10;
	supermovetime: -1;
	pausemovetime: -1;
	trans: add;
	alpha: 256,256;
	palfx.time: -1;
	palfx.mul: 256,256,256;
	scale: 0.6*const(size.xscale),0.6*const(size.yscale);
	interpolation.time: 10;
	interpolation.scale: 2.35*const(size.xscale),2.35*const(size.yscale);
	interpolation.palfx.mul: 0,0,256;
	interpolation.alpha: 0,256;
	ownpal: 1;
	shader: "trans_rights";
	shadertime: -1;
	}
	velSet{x: const(velocity.run.back.x); y: -3;}
	sysFVar(35) := 0.25;
	playSnd{value: S100,0;}
} else if animElem = 6 {
	map(CanActionCancel) := 1;
	map(CanMotionCancel) := 1;
} else if animElem = 10 {
	ctrlSet{value: 1;}
} else if animElem = 12 && p2Dist X < 0 {
	turn{}
}

if animElemTime(14) < 0 {
	if time%6 = 1 {
		explod{
		id: 10102;
		anim: 10102;
		pos: randomRange(-1500,1500)/100.0,randomRange(0,-10000)/100.0;
		postype: P1;
		sprpriority: 3;
		bindtime: 0;
		removetime: 14;
		facing: -1;
		supermovetime: -1;
		pausemovetime: -1;
		vel: 5,0;
		trans: add;
		alpha: 256,256;
		palfx.time: -1;
		palfx.mul: 256,256,256;
		scale: const(size.xscale),const(size.yscale);
		interpolation.time: 14;
		interpolation.palfx.mul: 0,0,256;
		interpolation.alpha: 0,256;
		ownpal: 1;
		shader: "trans_rights";
		shadertime: -1;
		}
	}
	notHitBy{value: ,AP; time: 1;}
	if abs(vel X) > 6 {
		velSet{x: max(abs(vel X) - 0.25, 6.0)*sign(vel X);}
	}
}

#-------------------------------------------------------------------------------
# GUARD (start)
[StateDef 120; type: U; physics: U;]
changeState{value: prevStateNo; ctrl: 1;}

[StateDef 130; type: S; physics: S;]
changeState{value: 0; ctrl: 1;}

[StateDef 131; type: C; physics: C;]
changeState{value: 11; ctrl: 1;}

[StateDef 132; type: A; physics: N;]
changeAnim{value: 41; elem: 12;}
changeState{value: 50; ctrl: 1;}

[StateDef 150; type: S; movetype: H; physics: S; sprpriority: 0; velset: 0,0;]
changeAnim{value: 150;}
if !time && p2Dist X < 0 {turn{}}
if !numExplod(10150) {
	explod{id: 10150; anim: 10150;
		pos: 28.5,-66;
		postype: P1;
		sprpriority: sprPriority+1;
		bindtime: -1;
		removetime: -1;
		scale: 1.5,1.5;
		supermovetime: 0;
		pausemovetime: 0;
		ignorehitpause: 1;
		ownpal: 1;
		shader: "trans_rights";
		shadertime: -1;}
} else {
	modifyExplod{id: 10150; postype: P1; pos: 24,-66;}
}
if hitShakeOver {changeState{value: 151; ctrl: 0;}}

[StateDef 152; type: C; movetype: H; physics: C; sprpriority: 0; velset: 0,0;]
changeAnim{value: 151;}
if !time && p2Dist X < 0 {turn{}}
if !numExplod(10150) {
	explod{id: 10150; anim: 10150;
		pos: 28.5,-30;
		postype: P1;
		sprpriority: sprPriority+1;
		bindtime: -1;
		removetime: -1;
		scale: 1.5,1.5;
		supermovetime: 0;
		pausemovetime: 0;
		ignorehitpause: 1;
		ownpal: 1;
		shader: "trans_rights";
		shadertime: -1;}
} else {
	modifyExplod{id: 10150; postype: P1; pos: 28.5,-30;}
}
if hitShakeOver {changeState{value: 153; ctrl: 0;}}

[StateDef 154; type: A; movetype: H; physics: N; sprpriority: 0; velset: 0,0;]
if !time && p2Dist X < 0 {turn{}}
changeAnim{value: 152;}
if !numExplod(10150) {
	explod{id: 10150; anim: 10150;
		pos: 28.5,-66;
		postype: P1;
		sprpriority: sprPriority+1;
		bindtime: -1;
		removetime: -1;
		scale: 1.5,1.5;
		supermovetime: 0;
		pausemovetime: 0;
		ignorehitpause: 1;
		ownpal: 1;
		shader: "trans_rights";
		shadertime: -1;}
} else {
	modifyExplod{id: 10150; postype: P1; pos: 28.5,-66;}
}
if hitShakeOver {changeState{value: 155; ctrl: 0;}}

#-------------------------------------------------------------------------------
# Air guard hit (knocked away)
[StateDef 155; type: A; movetype: H; physics: N; anim: 152;]

if time = 0 {
	hitVelSet{x: 1; y: 1}
	sysFVar(35) := 0.375;
}

if time = getHitVar(ctrlTime) {
	changeState{value: 50; ctrl: 1;}
}

if vel Y = 0 && pos Y >= 0 {
	changeState{value: 52; ctrl: 1;}
}

velAdd{y: sysFVar(35);}

if pos Y + vel Y >= 0 {
	posSet{y: 0;}
	velSet{y: 0;}
}

#-------------------------------------------------------------------------------
# Guard (end)
[StateDef 140; type: U; physics: U; ctrl: 1;]

if stateType = A {
	changeAnim{value: 41; elem: 12;}
	changeState{value: 50; ctrl: 1;}
} else if anim = 150 {
	changeState{value: 0; ctrl: 1;}
} else {
	changeState{value: 11; ctrl: 1;}
}

#-------------------------------------------------------------------------------
# Downed get-hit (hit ground from fall)
[StateDef 5100; type: L; movetype: H; physics: N; anim: 5100;]

if time = 0 {
	fallEnvShake{}
	forceFeedback{waveform: sinesquare; ampl: 128,-3,-.2,.005; time: 20}
	hitFallDamage{}
	posSet{y: 0}
	velSet{y: 0}
	velMul{x: .75}
	playSnd{value: S52,1; volumescale: 200;}
	explod{id: 15100; anim: 15100; pos: 0,0; postype: P1; sprpriority: 0; bindtime: 0; facing: 1; removetime: -2; supermovetime: -1; pausemovetime: -1; ownpal: 1; xangle: -80; shader: "trans_rights"; shadertime: -1;}
} else if animTime = 0 {
	changeState{value: 5101}
}
posFreeze{}

#-------------------------------------------------------------------------------
# Downed get-hit (bounce off ground)
[StateDef 5101; type: L; movetype: H; physics: N; anim: 5160;]

if time = 0 {
	hitFallVel{}
}

if vel y = 0 && pos y = 0 {
	changeState{value: 5110}
}
if time > 0 {
	velAdd{y: const(movement.down.bounce.yAccel)}
	if vel Y + pos Y >= 0 {
		velSet{y: 0;}
		posSet{y: 0;}
	}
}

#-------------------------------------------------------------------------------
# Downed get-hit (lying down)
[StateDef 5110; type: L; movetype: H; physics: N; anim: 5170;]

if time = 0 {
	posSet{y: 0}
	velSet{x: 0; y: 0}
} else if !animTime {
	if !alive {changeState{value: 5150}}
	changeAnim{value: 5110}
}

#-------------------------------------------------------------------------------
# Downed get-hit (getting up)
[StateDef 5120; type: L; movetype: I; physics: N; anim: 5120;]

if !time && (command = "holdx" || command = "holda" || command = "holdb" || command = "holdc") && (command = "holdleft" || command = "holdright") {
	changeState{value: 5121;}
}

notHitBy{value: ,AT; time: 10}
if animElem = 4 && p2Dist X < 0 {
	turn{}
} else if animElem = 5 {
	ctrlSet{value: 1}
} else if animTime = 0 {
	changeState{value: 0; ctrl: 1}
}

#-------------------------------------------------------------------------------
# Moving getting up
[StateDef 5121; type: L; movetype: I; physics: N; anim: 5121;]

if !time {
	if command = "holdfwd" {
		velSet{x: 7.5;}
	} else {
		velSet{x: -7.5;}
	}
}

if animElemTime(3) < 0 {
	posFreeze{}
} else if animElemTime(11) < 0 {
	playerPush{value: 0;}
}

notHitBy{value: ,AT; time: 10}
if animElem = 11 {
	if p2Dist X < 0 {turn{}}
	velSet{x: 0;}
} else if animElem = 12 {
	ctrlSet{value: 1}
} else if animTime = 0 {
	changeState{value: 0; ctrl: 1}
}

#===============================================================================
# Electron
#===============================================================================
[StateDef 10990; type: S; movetype: I; physics: N; anim: 9999; ctrl: 0;]

assertSpecial{flag: RunLast; flag2: AnimFreeze;}
notHitBy{attr: SCA,AA,AP,AT; time: -1;}
overrideClsn{group: size; rect: 0,0,0,0;}

let electronanim = root,anim+125320;

if selfAnimExist($electronanim) && root,animPlayerNo = playerNo {
	if anim != $electronanim {
		changeAnim{value: $electronanim;}
	}
	if animLength > 0 {
		let electronanim = root,animElemNo(-(root,hitPauseTime != 0 && !root,isAsserted(AnimateHitPause)));
		if animElemNo(0) != $electronanim {
			changeAnim{value: anim; elem: $electronanim;}
		}
	}
}

if !time {
	posSet{x: root,pos X+((animElemVar(XOffset)+root,animElemVar(XOffset))*root,facing); y: root,pos Y+animElemVar(YOffset)+root,animElemVar(YOffset);}
} else {
	posSet{x: lerp(pos X, root,pos X+((animElemVar(XOffset)+root,animElemVar(XOffset))*root,facing), 0.1); y: lerp(pos Y, root,pos Y+animElemVar(YOffset)+root,animElemVar(YOffset), 0.1);}
}

if !numHelper(10991) {
	helper{name: "Electron"; id: 10991; stateno: 10991; pos: 0,0; postype: P1; facing: 1;}
}

[StateDef 10991; type: S; movetype: I; physics: N; anim: 10990; ctrl: 0;]

if !parentExist || parent,stateNo != 10990 {
	destroySelf{removeexplods: 1; recursive: 1;}
}

assertSpecial{flag: RunLast;}
notHitBy{attr: SCA,AA,AP,AT; time: -1;}
overrideClsn{group: size; rect: 0,0,0,0;}

if shader != "trans_rights" {
	shaderSet{shader: "trans_rights"; time: -1;}
}

let trailPosX = pos X;
let trailPosY = pos Y;

fVar(0) := fVar(0)+1;
fVar(1) := fVar(1)-0.5;
let electime = rad(fVar(0));
let elecangle = $electime*8;
let radfvar1 = rad(fVar(1));
let dist = 50.0-(cos($electime)*40);
let posX = sin($elecangle)*$dist;
let posY = cos($elecangle)*$dist/2;

posSet{x: (($posX*cos($radfvar1))-($posY*sin($radfvar1)))*facing+parent,pos X; y: parent,pos Y+($posX*sin($radfvar1))+($posY*cos($radfvar1));}

sprPriority{value: root,sprPriority+(pos Y > parent,pos Y);}

if root,map(NoElectron) || root,animPlayerNo != playerNo {
	assertSpecial{flag: Invisible;}
	changeAnim{value: 10990;}
	removeExplod{id: 10991;}
	fVar(0) := 0;
} else if fVar(0) > 1 {
	let trailPosX = ($trailPosX-pos X)*facing;
	let trailPosY = ($trailPosY-pos Y);
	let trailScale = (($trailPosX**2)+($trailPosY**2))**0.5;
	explod{id: 10991; anim: 10991; pos: 0,0; postype: P1; syncid: id; synclayer: 0; syncparams: 0; bindtime: 0; removetime: 7; scale: 4.0/32.0,$trailScale/192; supermovetime: 0; pausemovetime: 0; shader: "soku_tail"; shadertime: -1; shaderparam.p0: 7; angle: deg(atan2($trailPosX,$trailPosY)); ownpal: 1; reflection: 1;}
	modifyExplod{id: 10991; sprpriority: sprPriority;}
}
